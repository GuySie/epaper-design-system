{#- ds_ink: what every selected panel can show, read from the end of each device's model ('3.5" BWRY', '7.5" GRAYSCALE_4'):
     'r' when every panel has red, 'y' yellow, 'g' when every one is grayscale, then '-'. An unknown model counts as black and
     white. The colour roles follow from it in ep_design.jinja (design system: Colour, Values per panel). -#}
{% set ns = namespace(r=true, y=true, g=true, n=0) %}{% for d in (ds_devs if (ds_devs is iterable and ds_devs is not string) else [ds_devs]) %}{% set ns.n = ns.n + 1 %}{% set sc0 = ((device_attr(d, 'model') or '').split(' ') | last) %}{% set sc = sc0.split('_') | first %}{% if not sc0.startswith('GRAYSCALE') %}{% set ns.g = false %}{% endif %}{% set ok = sc is match('^[BWGRY]+$') %}{% if not (ok and 'R' in sc) %}{% set ns.r = false %}{% endif %}{% if not (ok and 'Y' in sc) %}{% set ns.y = false %}{% endif %}{% endfor %}{{ ('r' if ns.r and ns.n > 0 else '') ~ ('y' if ns.y and ns.n > 0 else '') ~ ('g' if ns.g and ns.n > 0 else '') ~ '-' }}
