{%- elif layout == 'weather_glance_14' and view == 'main' -%}
{%- set stale = (stale_after | int(0)) > 0 and wx.last > 0 and (as_timestamp(now()) - wx.last) > (stale_after | int(0)) * 60 -%}
{%- set right = wx.last if stale else as_timestamp(now()) -%}

{%- macro SECOND(ns, cx, cy, fb, s, cw, maxw=999) -%}
{%- set pk = PICK(true) -%}
{%- if pk -%}
{%- set kind, lab, val, short = pk.split('§') -%}
{%- set mark = LEVEL_MARK(kind) -%}
{%- set full = mark ~ ((lab ~ ' ' ~ val) if lab else val) -%}
{%- set pad = 2 * (SPACE_S(s) | int) - 2 -%}
{%- if (VALUE_W(full, s, fb) | int) + pad <= maxw -%}{%- set v = full -%}
{%- elif (VALUE_W(mark ~ short, s, fb) | int) + pad <= maxw -%}{%- set v = mark ~ short -%}
{%- elif wx.alert -%}{%- set v = mark ~ wx.flag.code -%}
{%- else -%}{%- set v = FITW(mark ~ short, maxw - pad, s, fb) -%}{%- endif -%}
{{- CCHIP(ns, v, cx, cy, fb, s, cw, LEVEL_FILL(kind), LEVEL_TEXT(kind)) -}}
{%- elif wx.pollen is not none and wx.pollen.show -%}
{{- T(ns, (wx.pollen.name | upper) ~ ' ' ~ wx.pollen.v, cx, cy, fb, s, color.ink, 'mm', maxw) -}}
{%- else -%}
{{- T(ns, wx.hi ~ '° / ' ~ wx.lo ~ '°', cx, cy, fb, s, color.ink, 'mm') -}}
{%- endif -%}
{%- endmacro -%}

{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{%- call(y) GLANCE(ns, (header_title if header_title else ds_wtxt['title']), right, (wx.temp | string) ~ '°', wx.icon, stale, wx.temp_k, true, 'caller') -%}
{{- SECOND(ns, W // 2, y, FONT[EP_TK.type.secondary[0]], EP_TK.type.secondary[1], 0, W - 2 * P) -}}
{%- endcall -%}
{%- elif layout == 'weather_glance_14' and view == 'error' -%}
{{- ERRPAGE(ns, (header_title if header_title else ds_wtxt['title']), ds_wtxt['nodata']) -}}
{%- elif layout == 'weather_glance_35' and view == 'main' -%}
{%- set stale = (stale_after | int(0)) > 0 and wx.last > 0 and (as_timestamp(now()) - wx.last) > (stale_after | int(0)) * 60 -%}
{%- set right = wx.last if stale else as_timestamp(now()) -%}

