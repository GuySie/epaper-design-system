  {% elif a0 is string %}{% set wsubj.t = a0 %}{% endif %}
  {% if not wsubj.t and states(wts) not in ['none', 'unknown', 'unavailable', ''] and states(wts) | length <= 30 %}{% set wsubj.t = states(wts) %}{% endif %}
{% endif %} {% set me = moon_phase_sensor | default('') %} {% set me = me if me else ((integration_entities('moon') | first) | default('')) %} {% set mp = states(me) if me else 'unknown' %} {% set micon = none if mp in ['unknown', 'unavailable'] else ('mdi:moon-new' if mp == 'new_moon' else ('mdi:moon-full' if mp == 'full_moon' else 'mdi:moon-' ~ (mp | replace('_', '-')))) %} {%- set wx = {
  'ok': temp is not none,
  'temp': (temp | round(0) | int) if temp is not none else '—',
  'temp_k': temp_k,
  'icon_k': 'sev' if cond in cs_ else ('warn' if cond in cw_ else ''),
  'icon': 'mdi:' ~ ((dmap if up else nmap)[cond] | default('weather-cloudy')),
  'hi': today.temperature | default('—') | round(0) | int if today.temperature is defined else '—',
  'lo': today.templow | default('—') | round(0) | int if today.templow is defined else '—',
  'hilo_k': ('sev' if ((today.temperature | default(none)) is not none and ((today.temperature | float(0)) >= ths or (today.templow | default(today.temperature) | float(0)) <= tls)) else ('warn' if ((today.temperature | default(none)) is not none and ((today.temperature | float(0)) >= thw or (today.templow | default(today.temperature) | float(0)) <= tlw)) else '')),
  'mm_today': (today.precipitation | default(0) | float(0)) | round(1),
  'mm_today_k': 'sev' if (today.precipitation | default(0) | float(0)) >= rds else ('warn' if (today.precipitation | default(0) | float(0)) >= rdw else ''),
  'wind': (wind | float(0)) | round(0) | int if wind is not none else '—',
  'wind_unit': state_attr(forecast_entity, 'wind_speed_unit') or 'km/h',
  'pres_unit': state_attr(forecast_entity, 'pressure_unit') or 'hPa',
  'wind_k': '' if wind is none else ('sev' if (wind | float(0)) >= ws else ('warn' if (wind | float(0)) >= ww else '')),
  'hum': state_attr(forecast_entity, 'humidity'),
  'pres': (state_attr(forecast_entity, 'pressure') | float(0)) | round(0) | int if state_attr(forecast_entity, 'pressure') is not none else none,
  'dew': (state_attr(forecast_entity, 'dew_point') | float(0)) | round(0) | int if state_attr(forecast_entity, 'dew_point') is not none else none,
  'rise': n_rise | timestamp_custom(fmt) if n_rise else '—',
  'set': n_set | timestamp_custom(fmt) if n_set else '—',
  'hours': ns.hours,
  'days': ns.days,
  'pollen': none if pv is none else {'name': (pt if pt else 'Pollen'), 'v': ((pv | round(0) | int | string) ~ (('¦' ~ (state_attr(ps, 'unit_of_measurement') or '')) if state_attr(ps, 'unit_of_measurement') else '')), 'k': pk, 'show': pv > 0 or pk != ''},
  'moon': micon,
  'alert': {'k': 'warn' if wkey == 'wy' else 'sev', 'code': wkey, 'subj': wsubj.t} if wkey else none,
  'cond': cond,
  'flag': ({'k': 'warn' if wkey == 'wy' else 'sev', 'lab': ds_wtxt[wkey], 'val': ((wsubj.t if wsubj.t else ds_wtxt['alert']) | upper),
            'glance': ((ds_wtxt[wkey] | upper) ~ ' ' ~ (wsubj.t | upper)) if wsubj.t else (ds_wtxt[wkey] | upper),
            'short': (wsubj.t | upper) if wsubj.t else (ds_wtxt[wkey] | upper), 'code': ds_wtxt[wkey] | upper}) if wkey
          else (({'k': 'sev' if cond in cs_ else ('warn' if cond in cw_ else ''), 'lab': ds_wtxt['now'], 'val': (ds_wtxt['cond'][cond] | default(cond)) | upper,
            'glance': (ds_wtxt['cond'][cond] | default(cond)) | upper, 'short': (ds_wtxt['cond'][cond] | default(cond)) | upper})
            if ('sev' if cond in cs_ else ('warn' if cond in cw_ else '')) else none),
  'time': as_timestamp(now()) | timestamp_custom(fmt),
  'last': as_timestamp((expand(forecast_entity) | first).last_reported | default((expand(forecast_entity) | first).last_updated), 0) if expand(forecast_entity) | count > 0 else 0
} -%}
{%- endif -%}
{%- endif -%}
{#- ---- 4. kit ---- -#}
{#- ===== design system kit (identical in every blueprint) ===== -#}
{%- set ns = namespace(el=[]) -%}
{#- font.* tokens -> the kit's font variables (type.* roles name these keys) -#}
{%- set FONT = {'label12': f12, 'label16': f16b, 'unit12': f12r, 'unit16': f16r, 'text21': f21, 'strong21': f21b, 'hero': fhero,
  'label12x2': f12, 'unit12x2': f12r, 'label16x2': f16b, 'unit16x2': f16r, 'text21x2': f21, 'strong21x2': f21b} -%}
{#- SPACE_XS / SPACE_S: space.xs and space.s around a text size (12 16 21, and the exact 2x cuts 24 32 42) -#}
{%- macro SPACE_XS(sz) -%}{{ EP_SPACE.xs[sz | string] }}{%- endmacro -%}
{%- macro SPACE_S(sz) -%}{{ EP_SPACE.s[sz | string] }}{%- endmacro -%}
{#- glyph advances of the TRMNL cuts (bold and regular 12/16/21), for measuring text -#}
{#- KRN: the fonts' kerning between capitals, digits and number punctuation (e.g. '1,' -2 px, 'TE' -1 px); the renderer applies it, so widths must too -#}
{#- GLYPHS: characters the TRMNL fonts don't have, rewritten to ones they do. The basis: Unicode compatibility
     normalisation (NFKC: superscripts and subscripts, CO₂ -> CO2, the one-character degree units, the Ohm sign, squared units), the micro sign
     the fonts do have instead of Greek mu (Home Assistant writes μg/m³ with Greek mu), UCUM for a negative exponent
     (m⁻¹ -> m-1) and the SI brochure's half-high dot for a product of units. NORMALISE(t) applies them; T measures and draws
     the result, so every text on every device goes through it. -#}
{%- set GLYPHS = {'μ': 'µ', '²': '2', '³': '3', '¹': '1', '⁰': '0', '⁴': '4', '⁵': '5', '⁶': '6', '⁷': '7', '⁸': '8', '⁹': '9', '⁻': '-',
  '₀': '0', '₁': '1', '₂': '2', '₃': '3', '₄': '4', '₅': '5', '₆': '6', '₇': '7', '₈': '8', '₉': '9',
  '℃': '°C', '℉': '°F', '˚': '°', '⋅': '·', '∙': '·', 'Ω': 'Ω', '′': "'", '″': '"', '㎡': 'm2', '㎥': 'm3', '㏄': 'cc'} -%}
{%- macro NORMALISE(t) -%}{%- set g = namespace(t=t | string) -%}{%- for k in GLYPHS -%}{%- if k in g.t -%}{%- set g.t = g.t | replace(k, GLYPHS[k]) -%}{%- endif -%}{%- endfor -%}{{ g.t }}{%- endmacro -%}
{%- macro TEXT_W(t, s, f) -%}{%- set k = (s | string) ~ ('r' if 'Regular' in (f | string) else '') -%}{%- set w = namespace(n=0) -%}{%- for c in NORMALISE(t) -%}{%- set w.n = w.n + (ADV[k][c] if c in ADV[k] else (s // 2)) + ((KRN[k][loop.previtem ~ c] | default(0)) if not loop.first else 0) -%}{%- endfor -%}{{ w.n }}{%- endmacro -%}
{#- units: a value is written 'number¦unit' (more segments alternate big / small: '13¦°¦/6¦°').
     Digits followed by ° / °C / °F / % are split automatically. Small segments are one font step down
     (21 -> 16, 16 -> 12 on 3.5"+): letter units sit on the baseline 2 px after the number;
     °, °C, °F and % sit on the baseline like every other unit, 1 px after the number.
     Hero temperatures (Space Grotesk) keep their full-size degree sign. -#}
{#- units: one size step down (USTEP), always in the Regular cut -#}
{#- USTEP: a unit's size and font: one TRMNL step below its value, Regular, never below the label floor (type.label's size)
     and never below the screen's unit size (type.unit) while the value is that large: where 12 px lowercase is under the
     floor, a 16 px value keeps a 16 px unit -#}
{%- macro USTEP0(s) -%}{{ ({42: '32|' ~ f16r, 32: '24|' ~ f12r, 24: '21|' ~ f21}[s]) if s > 21 else ('16|' ~ f16r) if s >= 21 else (('12|' ~ f12r) if s >= 16 else ((s | string) ~ '|' ~ f12r)) }}{%- endmacro -%}
{%- macro USTEP(s, f) -%}{%- set u = USTEP0(s).split('|') -%}{%- set ls = [EP_TK.type.label[1], [EP_TK.type.unit[1], s | int] | min] | max -%}{{ (u | join('|')) if (u[0] | int) >= ls else ((ls | string) ~ '|' ~ {12: f12r, 16: f16r, 21: f21, 24: f12r, 32: f16r, 42: f21}[ls]) }}{%- endmacro -%}
{#- SEGS: the degree sign is its own segment, drawn at the VALUE's size in the Regular cut, attached; a C or F after it, and %, are small unit segments -#}
{%- macro SEGS(v, f) -%}{%- set v = v | string -%}{{ (((v | regex_replace('(\\d)°([CF])', '\\1¦°¦¦\\2¦')) | regex_replace('(\\d)°(?!¦)', '\\1¦°¦')) | regex_replace('(\\d)%', '\\1¦%¦')) if 'TRMNL' in (f | string) else v }}{%- endmacro -%}
{#- REGULAR_FONT: the Regular cut at a TRMNL size (the degree sign: value size, Regular) -#}
{%- macro REGULAR_FONT(s) -%}{{ {12: f12r, 16: f16r, 21: f21, 24: f12r, 32: f16r, 42: f21}[s | int] }}{%- endmacro -%}
{#- UGAP: the space between a value and its unit = one space of the unit's font (4 px TRMNL12, 6 px TRMNL16). None on narrow canvases,
     and none for symbols that attach: %, C/F after the degree sign, and the h/min/am/pm of durations and short hour labels -#}
{%- macro UGAP(p, su) -%}{{ 0 if (DS.tight or (p | trim) in EP_SPACE.unitGapNone) else ADV[(su | string) ~ 'r'][' '] }}{%- endmacro -%}
{%- macro VALUE_W(v, s, f) -%}
{%- set parts = SEGS(v, f).split('¦') -%}
{%- set u = USTEP(s, f).split('|') -%}
{%- set w = namespace(n=0) -%}
{%- for p in parts -%}{%- if p -%}
{%- if loop.index0 % 2 == 1 and p == '°' -%}{%- set w.n = w.n + (TEXT_W(p, s, REGULAR_FONT(s)) | int) -%}
{%- elif loop.index0 % 2 == 1 -%}{%- set w.n = w.n + (UGAP(p, u[0]) | int) + (TEXT_W(p, u[0] | int, u[1]) | int) -%}
{%- else -%}{%- set w.n = w.n + (TEXT_W(p, s, f) | int) -%}{%- endif -%}
{%- endif -%}{%- endfor -%}{{ w.n }}
{%- endmacro -%}
{#- LSB: TRMNL left side bearings per font ('_' = every other glyph) -#}
{#- DS.tight: units sit 2 px from their value (no space) on a canvas narrower than space.tightMm; set by TITLE (*Units and numbers*) -#}
{%- set DS = namespace(tight=false) -%}
{%- macro T(ns, v, x, y, f, s, c='black', a='lm', mw=0) -%}
{#- TRMNL advances include 2 px of trailing space: shift right/centre anchors so the ink itself ends on x (or centres on it) -#}
{#- ...and the first glyph's left side bearing (1 px at 12/16, 2 at 21): left anchors shift left so the ink itself starts on x -#}
{%- set v = NORMALISE(v) if 'TRMNL' in (f | string) else v -%}
{%- set vk = (s | string) ~ ('r' if 'Regular' in (f | string) else '') -%}
{%- set v0 = ((v | string) | replace('¦', ''))[:1] -%}
{%- set x = x + ((2 if a[0] == 'r' else (1 if a[0] == 'm' else (0 - ((LSB[vk][v0] if v0 in LSB[vk] else LSB[vk]['_']) if (v0 and vk in LSB) else 0)))) if 'TRMNL' in (f | string) else 0) -%}
{%- set v = SEGS(v, f) -%}
{%- if '¦' in v -%}
{%- set parts = v.split('¦') -%}
{%- set u = USTEP(s, f).split('|') -%}
{%- set su, fu = u[0] | int, u[1] -%}
{%- set tot = VALUE_W(v, s, f) | int -%}
{%- set base = y + CAPDN[s] + 1 -%}
{%- set cur = namespace(x=(x if a[0] == 'l' else ((x - tot // 2) if a[0] == 'm' else (x - tot)))) -%}
{%- for p in parts -%}{%- if p -%}
{%- if loop.index0 % 2 == 1 and p == '°' -%}
{%- set ns.el = ns.el + [{'type': 'text', 'value': p, 'x': (cur.x | int), 'y': base | int, 'font': REGULAR_FONT(s), 'size': s, 'color': c, 'anchor': 'ls'}] -%}
{%- set cur.x = cur.x + (TEXT_W(p, s, REGULAR_FONT(s)) | int) -%}
{%- elif loop.index0 % 2 == 1 -%}
{%- set cur.x = cur.x + (UGAP(p, su) | int) -%}
{%- set ns.el = ns.el + [{'type': 'text', 'value': p, 'x': (cur.x | int), 'y': base | int, 'font': fu, 'size': su, 'color': c, 'anchor': 'ls'}] -%}
{%- set cur.x = cur.x + (TEXT_W(p, su, fu) | int) -%}
{%- else -%}
{%- set ns.el = ns.el + [{'type': 'text', 'value': p, 'x': (cur.x | int), 'y': base | int, 'font': f, 'size': s, 'color': c, 'anchor': 'ls'}] -%}
{%- set cur.x = cur.x + (TEXT_W(p, s, f) | int) -%}
{%- endif -%}
{%- endif -%}{%- endfor -%}
{%- else -%}
{%- set e = {'type': 'text', 'value': v, 'x': (x | int), 'y': (y | int), 'font': f, 'size': s, 'color': c, 'anchor': a} -%}
{%- if (mw | int) > 0 -%}{%- set e = dict(e, max_width=(mw | int), truncate=true) -%}{%- endif -%}
{%- set ns.el = ns.el + [e] -%}
{%- endif -%}
{%- endmacro -%}
{#- decimal separator follows the language setting -#}
{#- ink placement for TRMNL text at anchor 'lm'/'mm'/'rm': caps and digits span y - CAPUP[s] .. y + CAPDN[s].
     TOPY(top, s) = the y that puts the caps' first row on top; BOTY(bottom, s) = the y that puts their last row on bottom -#}
{#- CAPH: cap height in px (ink of a capital) -#}
{%- macro CAPH(s) -%}{{ CAPUP[s] + CAPDN[s] + 1 }}{%- endmacro -%}
{%- macro TOPY(top, s) -%}{{ top + CAPUP[s] }}{%- endmacro -%}
{%- macro BOTY(bottom, s) -%}{{ bottom - CAPDN[s] }}{%- endmacro -%}
{#- ink placement: hero numerals (Space Grotesk Bold) start this many px right of their x at anchor 'lm' (first glyph's side bearing);
     HERO_INK_X gives the x that puts the first digit's ink exactly on x -#}
{#- HUP / HDN: hero digit ink above / below the anchor (SpaceGrotesk Bold, measured per hero size). HUP, HDN and SGB cover
     the whole hero ladder and are generated by lib/hero_metrics.py: don't edit them by hand -#}
{#- generated by lib/hero_metrics.py --write: don't edit by hand -#}
{#- end of generated tables -#}
{%- macro HERO_INK_X(x, t, hs) -%}{%- set c = (t | string)[:1] -%}{{ x - ((SGB[hs][c] if c in SGB[hs] else 0) if hs in SGB else 0) }}{%- endmacro -%}
{%- macro DECIMAL(v) -%}{{ (v | string) if weekday_lang == 'en' else (v | string).replace('.', ',') }}{%- endmacro -%}
{#- R: a filled rectangle. Two chip colours are outlines (a warning on a panel without a warning colour): 'outline', 2 x
     line.base, one line.base outside the chip's box, so the text keeps its gap (OMERGE joins touching ones); 'outline_in',
     a hero's, 2 x line.base + 1 inside its box, never joined -#}
{%- macro R(ns, x0, y0, x1, y1, c) -%}
{%- set b = EP_TK.line.base -%}
{%- if c == 'outline' -%}
{%- set ns.el = ns.el + [{'type': 'rectangle', 'x_start': (x0 | int) - b, 'y_start': (y0 | int) - b, 'x_end': (x1 | int) + b, 'y_end': (y1 | int) + b, 'outline': color.ink, 'width': 2 * b}] -%}
{%- elif c == 'outline_in' -%}
{%- set ns.el = ns.el + [{'type': 'rectangle', 'x_start': (x0 | int), 'y_start': (y0 | int), 'x_end': (x1 | int), 'y_end': (y1 | int), 'outline': color.ink, 'width': 2 * b + 1}] -%}
{%- else -%}
{%- set ns.el = ns.el + [{'type': 'rectangle', 'x_start': (x0 | int), 'y_start': (y0 | int), 'x_end': (x1 | int), 'y_end': (y1 | int), 'fill': c, 'outline': c, 'width': 1}] -%}
{%- endif -%}
{%- endmacro -%}
{#- OMERGE: touching warning outlines share one outline (stacked cell chips, neighbouring rows): run once on a finished
     payload. The joined outlines take the place of the first one. -#}
{%- macro OMERGE(ns) -%}
{%- set w = 2 * EP_TK.line.base -%}
{%- set st = namespace(bx=[], at=-1) -%}
{%- for e in ns.el -%}{%- if e.type == 'rectangle' and 'fill' not in e and e.outline == color.ink and e.width == w -%}
{%- if st.at < 0 -%}{%- set st.at = loop.index0 -%}{%- endif -%}
{%- set st.bx = st.bx + [[e.x_start, e.y_start, e.x_end, e.y_end]] -%}
{%- endif -%}{%- endfor -%}
{%- if st.bx | length > 1 -%}
{%- for _ in st.bx -%}
{%- set mg = namespace(out=[]) -%}
{%- for a in st.bx -%}
{%- set hit = namespace(i=-1) -%}
{%- for o in mg.out -%}{%- if hit.i < 0 and a[0] <= o[2] + w and o[0] <= a[2] + w and a[1] <= o[3] + w + 1 and o[1] <= a[3] + w + 1 -%}{%- set hit.i = loop.index0 -%}{%- endif -%}{%- endfor -%}
{%- if hit.i < 0 -%}{%- set mg.out = mg.out + [a] -%}
{%- else -%}{%- set o = mg.out[hit.i] -%}{%- set mg.out = mg.out[:hit.i] + [[[a[0], o[0]] | min, [a[1], o[1]] | min, [a[2], o[2]] | max, [a[3], o[3]] | max]] + mg.out[hit.i + 1:] -%}{%- endif -%}
{%- endfor -%}
{%- set st.bx = mg.out -%}
{%- endfor -%}
{%- set nw = namespace(el=[]) -%}
{%- for e in ns.el -%}
{%- if loop.index0 == st.at -%}{%- for o in st.bx -%}{%- set nw.el = nw.el + [{'type': 'rectangle', 'x_start': o[0], 'y_start': o[1], 'x_end': o[2], 'y_end': o[3], 'outline': color.ink, 'width': w}] -%}{%- endfor -%}
{%- elif not (e.type == 'rectangle' and 'fill' not in e and e.outline == color.ink and e.width == w) -%}{%- set nw.el = nw.el + [e] -%}{%- endif -%}
{%- endfor -%}
{%- set ns.el = nw.el -%}
{%- endif -%}
{%- endmacro -%}
{%- macro BOX(ns, x0, y0, x1, y1, c='black', w=1) -%}
{%- set ns.el = ns.el + [{'type': 'rectangle', 'x_start': (x0 | int), 'y_start': (y0 | int), 'x_end': (x1 | int), 'y_end': (y1 | int), 'outline': c, 'width': w}] -%}
{%- endmacro -%}
{#- L: a line; without a width it is a line, drawn at line.base -#}
{%- macro L(ns, x0, y0, x1, y1, w=none, c='black', dash=0, gap=4) -%}
{%- set e = {'type': 'line', 'x_start': (x0 | int), 'y_start': (y0 | int), 'x_end': (x1 | int), 'y_end': (y1 | int), 'fill': c, 'width': (EP_TK.line.base if w is none else w)} -%}
{%- if dash > 0 -%}{%- set e = dict(e, dashed=true, dash_length=dash, space_length=gap) -%}{%- endif -%}
{%- set ns.el = ns.el + [e] -%}
{%- endmacro -%}
{#- MDI icons are drawn as TEXT in the MDI font, not with the icon element: the icon element anti-aliases (odl-renderer passes
     fontmode="1" to draw.text(), which Pillow ignores), and on BWRY panels its 35-50 % gray edge pixels map to red.
     The text element sets draw.fontmode = "1" and draws pixel-exact. Names outside this table fall back to the icon element. -#}
{%- macro I(ns, name, x, y, s, c='black', a='mm') -%}
{%- set k = (name | string | trim)[4:] if (name | string | trim)[:4] == 'mdi:' else (name | string | trim) -%}
{%- if k in MDI -%}
{%- set ns.el = ns.el + [{'type': 'text', 'value': MDI[k], 'font': 'materialdesignicons-webfont.ttf', 'x': (x | int), 'y': (y | int), 'size': s, 'color': c, 'anchor': a}] -%}
{%- else -%}
{%- set ns.el = ns.el + [{'type': 'icon', 'value': name, 'x': (x | int), 'y': (y | int), 'size': s, 'color': c, 'anchor': a}] -%}
{%- endif -%}
{%- endmacro -%}
{%- macro POLY(ns, pts, c) -%}
{%- set ns.el = ns.el + [{'type': 'polygon', 'points': pts, 'fill': c, 'outline': c}] -%}
{%- endmacro -%}
{#- chip behind right-aligned text: cw = approximate bold advance per char -#}
{#- spacing scale: space.xs and space.s follow the text size (SPACE_XS, SPACE_S), M = space.m, L = space.l. Chips hang outward: text stays aligned, fill extends S sideways and XS up/down -#}
{#- chip colours by kind ('' / 'warn' / 'sev') -#}
{%- macro LEVEL_FILL(k) -%}{{ color.severe if k == 'sev' else color.warningChip }}{%- endmacro -%}
{%- macro LEVEL_TEXT(k) -%}{{ (color.onSevere if k == 'sev' else color.onWarning) if k else 'black' }}{%- endmacro -%}
{%- macro LEVEL_MARK(k) -%}{{ color.severeMark if k == 'sev' else '' }}{%- endmacro -%}
{#- the longest run of whole words of v that fits mw at size s / font f (a lone first word that is too long is kept, and cut by the layout) -#}
{%- macro FITW(v, mw, s, f) -%}
{%- set fw = namespace(t='', stop=false) -%}
{%- for w in (v | string).split(' ') -%}{%- if not fw.stop -%}{%- if loop.first or (VALUE_W(fw.t ~ ' ' ~ w, s, f) | int) <= mw -%}{%- set fw.t = (fw.t ~ ' ' ~ w) | trim -%}{%- else -%}{%- set fw.stop = true -%}{%- endif -%}{%- endif -%}{%- endfor -%}
{{- fw.t -}}
{%- endmacro -%}
{#- a flagged label/value detail row: one chip spans the label and the value (they change together) -#}
{%- macro DCHIP(ns, lab, lf, ls, v, x0, xr, cy, f, s, bg, fg, vopt=false, h=0) -%}
{#- a label/value row as one chip. The label is cut short so it keeps space.l from the value; the value is never cut.
     vopt (the alert row): the value is the warning's subject, which shows whole or not at all, so when the pair
     doesn't fit the subject is left out and the code carries the chip. h: the row pitch when the chip sits in a fixed
     row; it is then a row chip, h - 1 high, so stacked chips keep a 1 px paper gap -#}
{%- set xs, sx = SPACE_XS(s) | int, SPACE_S(s) | int -%}
{%- set ch = (h - 1) if h else (s + 2 * xs) -%}
{{- R(ns, x0 - sx, cy - (ch // 2), xr + sx, cy - (ch // 2) + ch - 1, bg) -}}
{%- set vw = VALUE_W(v, s, f) | int -%}
{%- if vopt and vw > xr - x0 - (VALUE_W(lab, ls, lf) | int) - EP_TK.space.l -%}
{{- T(ns, lab, x0, cy, lf, ls, fg, 'lm', xr + 1 - x0) -}}
{%- else -%}
{{- T(ns, lab, x0, cy, lf, ls, fg, 'lm', xr + 1 - x0 - vw - EP_TK.space.l) -}}
{{- T(ns, v, xr, cy, f, s, fg, 'rm') -}}
{%- endif -%}
{%- endmacro -%}
{#- DROWS: detail rows, the label/value rows beside a hero (hero group beside other content) (module 'Detail rows').
     rows  [[label, value, level], ...]; level 'sev' / 'warn' draws the row as a chip
     flag  the alert row (an official warning, else the current condition at warning/severe) or none;
           it comes first, and one row makes way so the block keeps its size: the first unflagged row
           in the layout's make-way order 'od', else the first warning-level one, else od[0]
     pol   the pollen row [type, count, level] (pollen above 0) or none; it comes last, and one row makes way in
           its own order 'op', chosen the same way among the rows the alert row left
     x0    the column's left edge (W - P - DCOLW); xr its right edge (W - P - 1)
     y0    centre of the first row; pitch space.detailRow
     lt / vt  type.fieldLabel / type.data roles [font, size]
     labels are cut short so they keep space.l from their value; values are never cut -#}
{#- DCOLW: the detail column's width, from its content: the widest label (in the device's language, type.fieldLabel) +
     space.l + the widest value the rows can show (worst cases passed in, type.data). It follows the language and the
     units, never the live values, so the layout doesn't move when the weather changes. -#}
{%- macro DCOLW(labels, values) -%}
{%- set lt, vt = EP_TK.type.fieldLabel, EP_TK.type.data -%}
{%- set m = namespace(l=0, v=0) -%}
{%- for l in labels -%}{%- set m.l = [m.l, VALUE_W(l | upper, lt[1], FONT[lt[0]]) | int] | max -%}{%- endfor -%}
{%- for v in values -%}{%- set m.v = [m.v, VALUE_W(v, vt[1], FONT[vt[0]]) | int] | max -%}{%- endfor -%}
{{ m.l + EP_TK.space.l + m.v }}
{%- endmacro -%}
{%- macro DROWS(ns, rows, flag, od, x0, xr, y0, pitch, lt, vt, pol=none, op=[]) -%}
{%- set lf, ls, vf, vs = FONT[lt[0]], lt[1], FONT[vt[0]], vt[1] -%}
{#- the rows that make way: the alert row chooses first, then the pollen row among the rows still shown -#}
{%- set g = namespace(l=[]) -%}
{%- for it, o in [[flag, od], [pol, op]] -%}{%- if it -%}
{%- set dr = namespace(i=-1) -%}
{%- for i in o -%}{%- if dr.i < 0 and i not in g.l and not rows[i][2] -%}{%- set dr.i = i -%}{%- endif -%}{%- endfor -%}
{%- for i in o -%}{%- if dr.i < 0 and i not in g.l and rows[i][2] == 'warn' -%}{%- set dr.i = i -%}{%- endif -%}{%- endfor -%}
{%- for i in o -%}{%- if dr.i < 0 and i not in g.l -%}{%- set dr.i = i -%}{%- endif -%}{%- endfor -%}
{%- set g.l = g.l + [dr.i] -%}
{%- endif -%}{%- endfor -%}
{%- set k = namespace(r=([[flag.lab, flag.val, flag.k]] if flag else [])) -%}
{%- for r in rows -%}{%- if loop.index0 not in g.l -%}{%- set k.r = k.r + [r] -%}{%- endif -%}{%- endfor -%}
{%- set rows = k.r + ([pol] if pol else []) -%}
{%- for lab, val, sev in rows -%}
{%- set y = y0 + loop.index0 * pitch -%}
{%- if sev -%}{{- DCHIP(ns, LEVEL_MARK(sev) ~ (lab | upper), lf, ls, val, x0, xr, y, vf, vs, LEVEL_FILL(sev), LEVEL_TEXT(sev), flag and loop.first, pitch) -}}
{%- else -%}{{- T(ns, lab | upper, x0, y, lf, ls, color.ink, 'lm', xr + 1 - x0 - (VALUE_W(val, vs, vf) | int) - EP_TK.space.l) -}}{{- T(ns, val, xr, y, vf, vs, color.ink, 'rm') -}}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- Chart frame (module 'Chart'), shared by the line and bar charts. The parts are drawn in the
     layout's own order, so a chart decides what lies on top (fills under thresholds, bars over them).
     CFRAME  sets the plot geometry on a namespace, inside the box the chart is given (x0 to x1, y0 to y1: its
             first and last column and row): x0, xr (the right edge of the label margin, x1), w (the plot's
             width left of a label margin of lw + space.s), top (y0, lower by half a label's cap height when a
             value label sits on the top line), base (the baseline, space.axis above y1: the axis band is
             under it), ph. The chart sets cf.xe (its last plot column) once it knows its own grid.
     CTHRESH a threshold: 1 px line dashed line.dash across the plot (line=false: label only), the value
             in the margin in type.label, right-aligned to the padding
     CBASE   the baseline, line.base
     CAXIS   axis under a baseline: ticks = [[x, text, anchor], ...]; a line.tick tick under the baseline and
             the text in type.label space.s below it (an empty text draws the tick only) -#}
{%- macro CFRAME(cf, x0, x1, y0, y1, lw, toplabel=false) -%}
{%- set cf.x0 = x0 -%}{%- set cf.xr = x1 -%}
{%- set cf.w = x1 + 1 - x0 - lw - (SPACE_S(EP_TK.type.label[1]) | int) -%}
{#- a value label centred on the plot's top line needs its upper half of cap height clear of M -#}
{%- set cf.top = y0 + (CAPUP[EP_TK.type.label[1]] if toplabel else 0) -%}
{#- under the baseline: the axis band, down to the box's last row -#}
{%- set cf.base = y1 - EP_TK.space.axis -%}
{%- set cf.ph = cf.base - cf.top -%}
{%- endmacro -%}
{#- CHART_Y0, CHART_Y1: the first and last row of a module that fills a page between the title row and the footer (a
     chart, the timeline): M under the title line, down to M above the footer -#}
{%- macro CHART_Y0() -%}{{ EP_TK.space.pad + EP_TK.space.titleRow + EP_TK.space.m }}{%- endmacro -%}
{%- macro CHART_Y1() -%}{{ EP_TK.height - EP_TK.space.pad - EP_TK.space.footer - EP_TK.space.m - 1 }}{%- endmacro -%}
{%- macro CTHRESH(ns, cf, txt, y, line=true) -%}
{%- if line -%}{{- L(ns, cf.x0, y, cf.xe, y, EP_TK.line.base, color.ink, EP_TK.line.dash[0], EP_TK.line.dash[1]) -}}{%- endif -%}
{{- T(ns, txt, cf.xr, y, FONT[EP_TK.type.label[0]], EP_TK.type.label[1], color.ink, 'rm') -}}
{%- endmacro -%}
{%- macro CBASE(ns, cf) -%}{{- L(ns, cf.x0, cf.base, cf.xe, cf.base, EP_TK.line.base) -}}{%- endmacro -%}
{#- AXIS_Y: the centre y of the axis labels under a baseline (also where markers below a horizon sit) -#}
{%- macro AXIS_Y(cf) -%}{%- set ls = EP_TK.type.label[1] -%}{{ cf.base + 1 + EP_TK.line.tick + (SPACE_S(ls) | int) + CAPUP[ls] }}{%- endmacro -%}
{%- macro CAXIS(ns, cf, ticks) -%}
{%- for x, txt, a in ticks -%}
{{- L(ns, x, cf.base + 1, x, cf.base + EP_TK.line.tick) -}}
{%- if txt -%}{{- T(ns, txt, x, AXIS_Y(cf) | int, FONT[EP_TK.type.label[0]], EP_TK.type.label[1], color.ink, a) -}}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- ELIST: event list (module 'Event list'). A time column in the strong type.primary cut (the scan anchor,
     right-aligned so the minutes line up), the title next to it in the regular cut, and a type.label line under
     the title (day · until end). The event happening now has its start time on an ink chip (*Severity*, *Now is not a severity*) that hugs the caps
     (space.xs above and below, space.s sideways, the TRMNL21 values). Rows are pitch apart; between rows a line
     sits centred in the gap between their ink (an odd pixel goes below). EINK: a row's ink height. -#}
{#- EPITCH: the event list's row pitch: a row's ink, then space.s, the line, space.s -#}
{%- macro EPITCH() -%}{{ (EINK() | int) + 2 * (SPACE_S(EP_TK.type.label[1]) | int) + EP_TK.line.base }}{%- endmacro -%}
{%- macro EINK() -%}{{ EP_PRIMARY[1][1] + (CAPH(EP_TK.type.label[1]) | int) }}{%- endmacro -%}
{%- macro ELIST(ns, events, x0, xr, y0, pitch, untl) -%}
{%- set pr, pb, lb = EP_PRIMARY[0], EP_PRIMARY[1], EP_TK.type.label -%}
{%- set fr, fb, ps = FONT[pr[0]], FONT[pb[0]], pb[1] -%}
{%- set lf, ls = FONT[lb[0]], lb[1] -%}
{%- set xs, ss = SPACE_XS(ps) | int, SPACE_S(ps) | int -%}
{%- set tw = namespace(w=0) -%}{%- for e in events -%}{%- set tw.w = [tw.w, VALUE_W(e.start, ps, fb) | int] | max -%}{%- endfor -%}
{%- set te = x0 + tw.w - 2 -%}
{%- set tx = te + EP_TK.space.l -%}
{%- set gap = pitch - (EINK() | int) -%}
{%- set ro = gap - (gap - 1) // 2 -%}
{%- for e in events -%}
{%- set y = y0 + loop.index0 * pitch -%}
{%- if not loop.first -%}{{- L(ns, x0, y - ro, xr, y - ro, EP_TK.line.base) -}}{%- endif -%}
{%- set cy = TOPY(y, ps) | int -%}
{%- set my = TOPY(y + ps, ls) | int -%}
{%- if e.is_current -%}
{%- set sw = VALUE_W(e.start, ps, fb) | int -%}
{{- R(ns, x0 + tw.w - sw - ss, cy - CAPUP[ps] - xs, te + ss, cy + CAPDN[ps] + xs, color.ink) -}}
{{- T(ns, e.start, te, cy, fb, ps, color.paper, 'rm') -}}
{%- else -%}
{{- T(ns, e.start, te, cy, fb, ps, color.ink, 'rm') -}}
{%- endif -%}
{{- T(ns, e.summary, tx, cy, fr, ps, color.ink, 'lm', xr + 1 - tx) -}}
{{- T(ns, (e.label | upper) ~ ' · ' ~ (untl | upper) ~ ' ' ~ e.end, tx, my, lf, ls, color.ink, 'lm', xr + 1 - tx) -}}
{%- endfor -%}
{%- endmacro -%}
{#- EFREE: the calendar footer, the next free moment: free from the end of the back-to-back run of events that
     starts now, else free until the next start (with its day when that isn't today). ft = [free until, free from] -#}
{%- macro EFREE(ns, events, ft, today, W, H, P) -%}
{%- set e0 = events[0] -%}
{%- if e0.is_current -%}
{%- set run = namespace(end=e0.end_ts, lab=e0.end) -%}
{%- for e in events[1:] -%}{%- if e.start_ts <= run.end -%}{%- set run.end, run.lab = [run.end, e.end_ts] | max, (e.end if e.end_ts >= run.end else run.lab) -%}{%- endif -%}{%- endfor -%}
{{- FOOT(ns, (ft[1] | upper) ~ ' ' ~ run.lab, '', W, H, P) -}}
{%- else -%}
{{- FOOT(ns, (ft[0] | upper) ~ ' ' ~ ((e0.label | upper ~ ' ') if e0.label != today else '') ~ e0.start, '', W, H, P) -}}
{%- endif -%}
{%- endmacro -%}
{#- EHERO: one event as a hero (module 'Event hero'): a label text line in type.data (the day, or the NOW label in an ink chip while it runs)
     with the time range on the right; the start time (the end while it runs) as a hero beside other content at type.heroShared, space.l under it
     (its digits measured: HUP above, HDN below the anchor); the title in type.primary's regular cut, space.l under the digits -#}
{%- macro EHERO(ns, e, W, P, y0) -%}
{#- the label text line in type.data, the hero at type.heroShared (its digits' ink measured, HUP / HDN),
     the title in the regular cut of type.primary -#}
{%- set ls, lf = EP_TK.type.data[1], FONT[EP_TK.type.data[0]] -%}
{%- set xs, sx = SPACE_XS(ls) | int, SPACE_S(ls) | int -%}
{%- set hs = EP_TK.type.heroShared -%}
{%- set pf, ps = FONT[EP_PRIMARY[0][0]], EP_PRIMARY[0][1] -%}
{%- set cy = TOPY(y0, ls) | int -%}
{%- if e.is_current -%}
{%- set lt = (e.label | upper) -%}
{{- R(ns, P - sx, cy - CAPUP[ls] - xs, P + (VALUE_W(lt, ls, lf) | int) - 3 + sx, cy + CAPDN[ls] + xs, color.ink) -}}
{{- T(ns, lt, P, cy, lf, ls, color.paper, 'lm') -}}
{%- else -%}
{{- T(ns, e.label | upper, P, cy, lf, ls, color.ink, 'lm') -}}
{%- endif -%}
{{- T(ns, e.time_range, W - P - 1, cy, lf, ls, color.ink, 'rm') -}}
{%- set ht = e.end if e.is_current else e.start -%}
{%- set hy = cy + CAPDN[ls] + EP_TK.space.l + HUP[hs] -%}
{{- T(ns, ht, HERO_INK_X(P, ht, hs) | int, hy, fhero, hs, color.ink, 'lm') -}}
{{- T(ns, e.summary, P, TOPY(hy + HDN[hs] + EP_TK.space.l, ps) | int, pf, ps, color.ink, 'lm', W - 2 * P) -}}
{%- endmacro -%}
{#- PBAR: progress track (component 'Progress bar'). A line.base ink outline from x0 to x1, h high; the fill inside
     it in colour fc; an optional now-marker (line.series wide, across the track) at marker %, with 1 px paper gaps
     either side where it stands in a dark fill. -#}
{%- macro PBAR(ns, x0, x1, y0, h, pct, marker, fc) -%}
{%- set y1 = y0 + h -%}
{%- set lb = EP_TK.line.base -%}
{{- BOX(ns, x0, y0, x1, y1, color.ink, lb) -}}
{%- set fw = ((x1 - x0 + 1 - 2 * lb) * pct / 100) | round | int -%}
{%- if fw > 0 -%}{{- R(ns, x0 + lb, y0 + lb, x0 + lb - 1 + fw, y1 - lb, fc) -}}{%- endif -%}
{%- if marker is not none -%}
{%- set mx = (x0 + (x1 - x0) * marker / 100) | round | int -%}
{#- the now-marker: a line as wide as a series stroke, across the track only -#}
{%- set mw = EP_TK.line.series -%}
{{- R(ns, mx - mw // 2, y0, mx - mw // 2 + mw - 1, y1, color.ink) -}}
{%- if fc != 'yellow' and mx - 1 > x0 + lb and mx < x0 + lb - 1 + fw -%}{%- set ml = mx - mw // 2 -%}{{- L(ns, ml - 1, y0 + lb, ml - 1, y1 - lb, 1, color.paper) -}}{{- L(ns, ml + mw, y0 + lb, ml + mw, y1 - lb, 1, color.paper) -}}{%- endif -%}
{%- endif -%}
{%- endmacro -%}
{#- CCHIP: a centred chip around v at (cx, cy): the text + 2 x space.s wide, s + 2 x space.xs high. On a stacked text line, p is the pitch to the neighbouring text line and the chip is p - 1 high (a 1 px paper gap to a chip next to it) -#}
{#- CHIPW: the width of a centred chip around v (space.s past the text on both sides) -#}
{%- macro CHIPW(v, s, f) -%}{{ (VALUE_W(v, s, f) | int) - 2 + 2 * (SPACE_S(s) | int) }}{%- endmacro -%}
{%- macro CCHIP(ns, v, cx, cy, f, s, cw, bg, fg, p=0) -%}
{%- set xs = SPACE_XS(s) | int -%}
{%- set w = CHIPW(v, s, f) | int -%}
{%- set ch = (p - 1) if p else (s + 2 * xs) -%}
{{- R(ns, cx - (w // 2), cy - (ch // 2), cx - (w // 2) + w - 1, cy - (ch // 2) + ch - 1, bg) -}}
{{- T(ns, v, cx, cy, f, s, fg, 'mm') -}}
{%- endmacro -%}
{#- RCHIP: a right-aligned chip ending at xr (space.s past the text); s + 2 x space.xs high, or rh - 1 in a fixed row of rh -#}
{%- macro RCHIP(ns, v, xr, cy, f, s, h, cw, bg, fg, rh=0) -%}
{%- set xs, sx = SPACE_XS(s) | int, SPACE_S(s) | int -%}
{%- set tw = VALUE_W(v, s, f) | int -%}
{%- set ch = (rh - 1) if rh else (s + 2 * xs) -%}
{{- R(ns, xr - tw + 2 - sx, cy - (ch // 2), xr + sx, cy - (ch // 2) + ch - 1, bg) -}}
{{- T(ns, v, xr, cy, f, s, fg, 'rm') -}}
{%- endmacro -%}
{#- update stamp: weekday + time, e.g. ZO 17:58 (TITLE turns a number into this) -#}
{%- macro STAMP(ts) -%}
{%- set wd = EP_DAYS_SHORT -%}
{%- set t = ts | float(0) -%}
{{- ((wd[weekday_lang] if weekday_lang in wd else wd['en'])[(t | timestamp_custom('%u') | int(1)) - 1] | upper) ~ ' ' ~ (t | timestamp_custom('%H:%M' if time_format == '24h' else '%-I:%M %p')) -}}
{%- endmacro -%}
{#- Hero group on its own (the Glance): number first, then icon, centred as one group between y0 and y1.
     The icon takes the first size in ics that fits; with none, it drops. The number never shrinks. -#}
{#- DATA_REGULAR: the Regular cut of type.data's size where its stems clear stroke.min (pitch x stem width), else the Bold cut -#}
{%- macro DATA_REGULAR() -%}{%- set ds = EP_TK.type.data[1] -%}{%- set rk = {12: ['unit12', 1], 16: ['unit16', 1], 21: ['text21', 2], 24: ['unit12x2', 2], 32: ['unit16x2', 2], 42: ['text21x2', 4]}[ds] -%}{{ FONT[rk[0]] if rk[1] * EP_TK.pitch >= EP_STROKE.strokeMinMm else FONT[EP_TK.type.data[0]] }}{%- endmacro -%}
{#- HERO_CHIP: the chip behind a flagged hero number: the digits' ink (HUP / HDN around the anchor, xl..xr wide) plus
     space.s of type.data on every side -#}
{%- macro HERO_CHIP(ns, xl, xr, cy, hs, bg) -%}{%- set sx = SPACE_S(EP_TK.type.data[1]) | int -%}{{- R(ns, xl - sx, cy - HUP[hs] - sx, xr + sx, cy + HDN[hs] + sx, 'outline_in' if bg == 'outline' else bg) -}}{%- endmacro -%}
{%- macro HERO_ALONE(ns, txt, icon_name, W, P, y0, y1, hs, ics, sev=false, sc='red', on_sc='white', moon=false) -%}
{%- set t = txt | string -%}
{%- set nd = t | select('in', '0123456789') | list | length -%}
{%- set gap = (hs // EP_SPACE.heroGapDiv) -%}
{%- set fit = namespace(ic=0) -%}
{#- fit and centre by INK: the numeral's measured ink width (HERO_INK_W), the icon's full box -#}
{%- set tin = HERO_INK_W(t, hs) | int -%}
{%- for c in ics -%}{%- if fit.ic == 0 and tin + gap + c <= W - 2 * P -%}{%- set fit.ic = c -%}{%- endif -%}{%- endfor -%}
{#- the icon is fitted by its box but centred by its ink: its blank right margin (ICB, measured) is left out -#}
{%- set ik = (icon_name | string | trim)[4:] if (icon_name | string | trim)[:4] == 'mdi:' else (icon_name | string | trim) -%}
{%- set br = ((ICB[ik][1] if ik in ICB else 0) * fit.ic) | round | int -%}
{%- set gw = tin + ((gap + fit.ic - br) if fit.ic else 0) -%}
{%- set x0 = ((W - gw) / 2) | round | int -%}
{%- set cy = ((y0 + y1) / 2) | round | int -%}
{%- if sev -%}{{- HERO_CHIP(ns, x0, x0 + tin - 1, cy, hs, sc) -}}{%- endif -%}
{{- T(ns, t, HERO_INK_X(x0, t, hs) | int, cy, fhero, hs, on_sc if sev else color.ink, 'lm') -}}
{%- if fit.ic -%}{%- set ix = x0 + tin + gap + fit.ic // 2 -%}{{- I(ns, icon_name, ix, cy, fit.ic) -}}{%- if moon -%}{{- MOON_BADGE(ns, ix, cy, fit.ic, W - P - 1) -}}{%- endif -%}{%- endif -%}
{%- endmacro -%}
{#- title row: title left, timestamp right, 1 px line; stale => timestamp in an ink chip with '!' -#}
{%- macro TITLE(ns, title, right, W, P, TH, stale=false) -%}
{#- title left in type.title, update stamp right in type.stamp on the title's baseline; right = '' draws no stamp.
     Padding is measured to the ink: caps start at P, the line (line.base) sits space.s below them (TH = space.titleRow).
     The title is cut short so it keeps space.l from the stamp. A stale chip is a chip in the title's type. -#}
{%- set tt, st = EP_TK.type.title, EP_TK.type.stamp -%}
{%- set fb, s = FONT[tt[0]], tt[1] -%}
{%- set rw = EP_TK.line.base -%}
{%- set DS.tight = (W * EP_TK.pitch) < EP_SPACE.tightMm -%}
{%- set right = STAMP(right) if right is number else (right | string) -%}
{%- set cy = TOPY(P, s) | int -%}
{%- set sx = SPACE_S(s) | int -%}
{%- set stxt = ('! ' ~ right) if stale else right -%}
{%- set sf, ss = FONT[st[0]], st[1] -%}
{%- set sdy = CAPDN[s] - CAPDN[ss] -%}
{%- if stale -%}{%- set sf, ss, sdy = fb, s, 0 -%}{%- endif -%}
{%- set sw = 0 if not right else ((TEXT_W(stxt, ss, sf) | int) - 2 + (sx if stale else 0) + EP_TK.space.l) -%}
{{- T(ns, title | upper, P, cy, fb, s, color.ink, 'lm', W - 2 * P - sw) -}}
{%- if right and stale -%}
{{- RCHIP(ns, stxt, W - P - 1, cy, fb, s, 0, 0, 'outline' if color.warningChip == 'outline' else color.ink, color.ink if color.warningChip == 'outline' else color.paper) -}}
{%- elif right -%}
{{- T(ns, right, W - P - 1, cy + sdy, sf, ss, color.ink, 'rm') -}}
{%- endif -%}
{{- L(ns, P, P + TH - rw, W - P - 1, P + TH - rw, rw) -}}
{%- endmacro -%}
{#- full-width row; kind: none | 'warn' | 'sev' ; returns nothing, draws label left / value right -#}
{%- macro ROW(ns, label, value, x0, x1, y, h, f, fb, s, kind=none, sc='red', on_sc='white', mark='', lw=0, rule=false, ls=0, lf='') -%}
{#- ls / lf: a smaller label (name) size and font, like a label/value detail row; the value keeps s -#}
{%- set ls = ls if ls else s -%}{%- set lfn = lf if lf else f -%}{%- set lfb = lf if lf else fb -%}
{#- the label is cut short so it keeps at least space.l from its value (a caller's tighter column width wins) -#}
{%- set lmax = x1 + 1 - x0 - (VALUE_W(value, s, fb) | int) - EP_TK.space.l -%}
{%- set lw = [lw, lmax] | min if lw else lmax -%}
{%- set cy = y + (h // 2) -%}
{%- if kind == 'sev' -%}
{{- R(ns, x0 - (SPACE_S(s) | int), y, x1 + (SPACE_S(s) | int), y + h - 2, sc) -}}
{{- T(ns, mark ~ label, x0, cy - 1, lfb, ls, on_sc, 'lm', lw) -}}
{{- T(ns, value, x1, cy - 1, fb, s, on_sc, 'rm') -}}
{%- elif kind == 'warn' -%}
{{- R(ns, x0 - (SPACE_S(s) | int), y, x1 + (SPACE_S(s) | int), y + h - 2, color.warningChip) -}}
{{- T(ns, label, x0, cy - 1, lfb, ls, color.onWarning, 'lm', lw) -}}
{{- T(ns, value, x1, cy - 1, fb, s, color.onWarning, 'rm') -}}
{%- else -%}
{{- T(ns, label, x0, cy - 1, lfn, ls, color.ink, 'lm', lw) -}}
{{- T(ns, value, x1, cy - 1, fb, s, color.ink, 'rm') -}}
{%- endif -%}
{#- the row line runs under chipped rows too, on the 1 px paper gap between chips; under an ink chip (B/W) the paper gap is the line -#}
{%- set cbg = (sc if kind == 'sev' else (color.warningChip if kind == 'warn' else color.paper)) -%}
{%- if rule and cbg not in [color.ink, 'outline'] -%}{{- L(ns, x0 - ((SPACE_S(s) | int) if kind else 0), y + h - 1, x1 + ((SPACE_S(s) | int) if kind else 0), y + h - 1, EP_TK.line.base) -}}{%- endif -%}
{%- endmacro -%}
{#- KV / KVLIST: key-value rows (component 'Key-value row'). A name in type.label left, its value in type.data right on
     the column edge, in fixed row boxes of space.row (space.rowDense where a tier has one and the list needs it). A level
     ('sev' / 'warn') turns the row into a chip. The name is cut short so it keeps space.l from its value.
     KVLIST lays items [[name, value, level], ...] out in one column with a line under every row but the last, or in two
     columns (column-major, per rows each, space.l apart with a divider in the middle) without lines. The first
     row's box starts at top, which a layout sets M below the title line (fixed rows are measured to boxes). -#}
{%- macro KV(ns, label, value, x0, x1, y, kind=none, rule=false, dense=false) -%}
{%- set lt, dt = EP_TK.type.label, EP_TK.type.data -%}
{{- ROW(ns, label, value, x0, x1, y, EP_TK.space.rowDense if dense else EP_TK.space.row, FONT[dt[0]], FONT[dt[0]], dt[1], kind, color.severe, color.onSevere, color.severeMark, 0, rule, lt[1], FONT[lt[0]]) -}}
{%- endmacro -%}
{#- KVFIT: how many key-value rows fit from top down to the content's bottom yb: the last row's ink (its type.data caps,
     centred in the row) must end above yb, so its box may hang its lower margin into the padding -#}
{%- macro KVFIT(top, yb, dense=false) -%}{%- set rh = EP_TK.space.rowDense if dense else EP_TK.space.row -%}{{ ((yb - top - rh // 2 - CAPDN[EP_TK.type.data[1]]) // rh) + 1 }}{%- endmacro -%}
{%- macro KVLIST(ns, items, x0, x1, top, per, two, dense=false) -%}
{%- set rh = EP_TK.space.rowDense if dense else EP_TK.space.row -%}
{%- set gap = EP_TK.space.l -%}
{%- set cw = ((x1 + 1 - x0 - gap) // 2) if two else (x1 + 1 - x0) -%}
{%- if two -%}{{- L(ns, x0 + cw + gap // 2, top, x0 + cw + gap // 2, top + per * rh - 2) -}}{%- endif -%}
{%- for lab, val, kind in items -%}
{%- set cx0 = x0 + (loop.index0 // per) * (cw + gap) -%}
{{- KV(ns, lab, val, cx0, cx0 + cw - 1, top + (loop.index0 % per) * rh, kind, (not two) and not loop.last, dense) -}}
{%- endfor -%}
{%- endmacro -%}
{#- DLIST: date-grouped list (module 'Date-grouped list'), the calendar. rows = [{'k': 'head', 't': day}, {'k': 'ev', 'l':
     line}, {'k': 'more', 't': '+N more'}], already cut to what fits (DAY_HEAD_H and space.rowDense are the heights to budget with).
     Day header: type.label caps, after the first one with a line above it, space.s between line, caps and the next row.
     Event: fixed rows of space.rowDense with type.data caps centred in the box; the time right-aligned (so the minutes
     line up) in a column as wide as the widest time + space.l, the title after it (cut short at the edge); an event without a time starts at the column's left.
     The event happening now is an ink row chip (the row box minus a 1 px paper gap, space.s into the padding sideways). -#}
{%- macro DAY_HEAD_H() -%}{%- set ls = EP_TK.type.label[1] -%}{{ 1 + EP_TK.line.base + 2 * (SPACE_S(ls) | int) + (CAPH(ls) | int) }}{%- endmacro -%}
{%- macro DLIST(ns, rows, x0, xr, top, now_ts, none_txt) -%}
{%- set lt, dt = EP_TK.type.label, EP_TK.type.data -%}
{%- set lf, ls, df, ds = FONT[lt[0]], lt[1], FONT[dt[0]], dt[1] -%}
{%- set rh, s0, sd = EP_TK.space.rowDense, SPACE_S(ls) | int, SPACE_S(ds) | int -%}
{%- set cyo = (rh - (CAPH(ds) | int)) // 2 -%}
{%- macro iscur(l) -%}{{ l.start_ts is defined and l.start_ts <= now_ts and l.end_ts > now_ts }}{%- endmacro -%}
{%- set tw = namespace(w=0) -%}
{%- for r in rows -%}{%- if r.k == 'ev' and r.l.time -%}
{%- set tw.w = [tw.w, VALUE_W(r.l.time, ds, df) | int] | max -%}
{%- endif -%}{%- endfor -%}
{%- set te = x0 + tw.w - 2 -%}{%- set tx = te + EP_TK.space.l -%}
{%- set y = namespace(v=top) -%}
{%- for r in rows -%}
{%- if r.k == 'head' -%}
{%- if not loop.first -%}{{- L(ns, x0, y.v + 1, xr, y.v + 1, EP_TK.line.base) -}}{%- set cap0 = y.v + 1 + EP_TK.line.base + s0 -%}{%- else -%}{%- set cap0 = y.v -%}{%- endif -%}
{{- T(ns, r.t | upper, x0, TOPY(cap0, ls) | int, lf, ls, color.ink, 'lm', xr + 1 - x0) -}}
{%- set y.v = cap0 + (CAPH(ls) | int) + s0 -%}
{%- elif r.k == 'more' -%}
{{- T(ns, r.t | upper, tx, TOPY(y.v + cyo, ds) | int, df, ds, color.ink, 'lm', xr + 1 - tx) -}}
{%- set y.v = y.v + rh -%}
{%- else -%}
{%- set l = r.l -%}
{%- set cy = TOPY(y.v + cyo, ds) | int -%}
{%- if iscur(l) == 'True' -%}
{{- R(ns, x0 - sd, y.v, xr + sd, y.v + rh - 2, color.ink) -}}
{{- T(ns, l.time, te, cy, df, ds, color.paper, 'rm') -}}
{{- T(ns, l.text, tx if l.time else x0, cy, df, ds, color.paper, 'lm', xr + 1 - (tx if l.time else x0)) -}}
{%- elif l.text == none_txt -%}
{{- T(ns, l.text | upper, x0, cy, df, ds, color.ink, 'lm', xr + 1 - x0) -}}
{%- else -%}
{{- T(ns, l.time, te, cy, df, ds, color.ink, 'rm') -}}
{{- T(ns, l.text, tx if l.time else x0, cy, df, ds, color.ink, 'lm', xr + 1 - (tx if l.time else x0)) -}}
{%- endif -%}
{%- set y.v = y.v + rh -%}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- SERIES: a line series (line.series) through pts [[x, y], ...]: solid up to index cut (measured), dashed
     line.forecastDash after it (still to come), the dashes measured along the curve so the dashes run through the joins. Used by the sun path; any chart with a forecast part draws its line the same way. -#}
{%- macro SERIES(ns, pts, cut) -%}
{%- set n = pts | length - 1 -%}
{%- set dl = namespace(s=[0]) -%}
{%- for i in range(1, n + 1) -%}{%- set a, b = pts[i - 1], pts[i] -%}{%- set dl.s = dl.s + [dl.s[-1] + ((b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2) | sqrt] -%}{%- endfor -%}
{%- for i in range(cut) -%}
{{- LINE_SERIES(ns, pts[i][0] | round | int, pts[i][1] | round | int, pts[i + 1][0] | round | int, pts[i + 1][1] | round | int) -}}
{%- endfor -%}
{%- set on_, off_ = EP_TK.line.forecastDash[0], EP_TK.line.forecastDash[1] -%}
{%- set d = namespace(on=true, x=pts[cut][0], y=pts[cut][1], nx=dl.s[cut] + on_) -%}
{%- for i in range(cut, n) -%}
{%- set a, b, s0, s1 = pts[i], pts[i + 1], dl.s[i], dl.s[i + 1] -%}
{%- for j in range(4) -%}
{%- if d.nx <= s1 and s1 > s0 -%}
{%- set t = (d.nx - s0) / (s1 - s0) -%}
{%- set px, py = a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t -%}
{%- if d.on -%}{{- LINE_SERIES(ns, d.x | round | int, d.y | round | int, px | round | int, py | round | int) -}}{%- endif -%}
{%- set d.x, d.y, d.on = px, py, not d.on -%}
{%- set d.nx = d.nx + (on_ if d.on else off_) -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- if d.on -%}{{- LINE_SERIES(ns, d.x | round | int, d.y | round | int, pts[n][0] | round | int, pts[n][1] | round | int) -}}{%- endif -%}
{%- endmacro -%}
{#- TMARK: a marker on a timeline: in the sky, the icon (icon.inline) centred over a paper disc of icon.markerDisc so a
     path behind it never runs through it; below the horizon, the icon alone on the axis label text line (AXIS_Y) -#}
{%- macro TMARK(ns, icon, x, y, up) -%}
{%- if up -%}
{%- set ns.el = ns.el + [{'type': 'circle', 'x': x, 'y': y, 'radius': EP_TK.icon.markerDisc, 'fill': color.paper, 'outline': color.paper, 'width': 1}] -%}
{%- endif -%}
{{- I(ns, icon, x, y, EP_TK.icon.inline, color.ink, 'mm') -}}
{%- endmacro -%}
{#- footer line at the bottom of the content box; kind none draws a 1 px line above -#}
{%- macro FOOT(ns, left, right, W, H, P, kind=none) -%}
{%- set dt = EP_TK.type.data -%}
{%- set f, fb, s, sc, on_sc, mark = FONT[dt[0]], FONT[dt[0]], dt[1], color.severe, color.onSevere, color.severeMark -%}
{#- padding measured to the ink: the text's ink ends on row H - P - 1 (P empty rows below it); the line sits S above the caps
     (the band is space.footer high), in type.data. The left text is cut short so it keeps space.l from the right one -#}
{%- set left, right = (left | string), (right | string) -%}
{%- set up, dn = CAPUP[s], CAPDN[s] -%}
{%- set xs, sx = SPACE_XS(s) | int, SPACE_S(s) | int -%}
{%- set cy = BOTY(H - P - 1, s) | int -%}
{%- set rw = EP_TK.line.base -%}
{%- set y0 = cy - up - sx - rw -%}
{%- set chip = kind in ['sev', 'warn'] -%}
{%- set lmw = W - 2 * P - (((VALUE_W(right, s, fb if chip else f) | int) + EP_TK.space.l) if right else 0) -%}
{%- if chip -%}
{{- R(ns, P - sx, cy - up - xs, W - P - 1 + sx, cy + dn + xs, sc if kind == 'sev' else color.warningChip) -}}
{{- T(ns, (mark if kind == 'sev' else '') ~ left, P, cy, fb, s, on_sc if kind == 'sev' else color.onWarning, 'lm', lmw) -}}
{{- T(ns, right, W - P - 1, cy, fb, s, on_sc if kind == 'sev' else color.onWarning, 'rm') -}}
{%- else -%}
{{- L(ns, P, y0, W - P - 1, y0, rw) -}}
{{- T(ns, left, P, cy, f, s, color.ink, 'lm', lmw) -}}
{{- T(ns, right, W - P - 1, cy, f, s, color.ink, 'rm') -}}
{%- endif -%}
{%- endmacro -%}
{#- FNEED: the room a footer takes under a module: space.m above the line + the footer -#}
{%- macro FNEED(P) -%}{{ EP_TK.space.m + EP_TK.space.footer }}{%- endmacro -%}
{#- 4-step level meter, left edge x, vertically centred on cy -#}
{%- macro METER(ns, level, x, cy, seg, fg='black') -%}
{%- for i in range(4) -%}
{%- set sx = x + i * (seg + 2) -%}
{%- if i < level -%}{{- R(ns, sx, cy - (seg // 2), sx + seg - 1, cy - (seg // 2) + seg - 1, fg) -}}
{%- else -%}{{- BOX(ns, sx, cy - (seg // 2), sx + seg - 1, cy - (seg // 2) + seg - 1, fg) -}}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- error screen body: error block with centred message under the title row -#}
{%- macro ERRBLOCK(ns, msg, W, H, P, TH, top=none, bottom=none) -%}
{#- the error block: everything under the title row becomes one severe chip (M below the title line, space.s into the
     padding sideways) with the message centred in the title's type; top and bottom bound it to one half of a page of two
     modules (Hero dashboard with a chart or list) -#}
{%- set tt = EP_TK.type.title -%}
{%- set sx = SPACE_S(tt[1]) | int -%}
{%- set y0 = top if top is not none else P + TH + (EP_TK.space.m) -%}
{%- set y1 = bottom if bottom is not none else H - P -%}
{{- R(ns, P - sx, y0, W - P - 1 + sx, y1 - 1, color.severe) -}}
{%- set ns.el = ns.el + [{'type': 'text', 'value': (msg | string | upper), 'x': (W // 2), 'y': ((y0 + y1) // 2), 'font': FONT[tt[0]], 'size': tt[1], 'color': color.onSevere, 'anchor': 'mm', 'align': 'center', 'max_width': (W - 2 * P - 2 * sx), 'spacing': sx}] -%}
{%- endmacro -%}
{#- STAMP_AT: the time the update stamp shows: this redraw's, or the newest data's while the data is stale (*Title row*) -#}
{%- macro STAMP_AT(last, stale) -%}{{ (last | float(0)) if stale else as_timestamp(now()) }}{%- endmacro -%}
{#- ERRPAGE: a page in its Error state: the title row with the time of this redraw (there is no data whose time to show)
     and the error block under it -#}
{%- macro ERRPAGE(ns, title, msg) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, as_timestamp(now()), W, P, TH) -}}
{{- ERRBLOCK(ns, msg, W, H, P, TH) -}}
{%- endmacro -%}
{#- EMPTY: the empty statement, one centred uppercase text line where a module has nothing to say, in the strong type.primary
     cut, one step down to type.data when it doesn't fit (or where a tier has no primary), centred in the box x0..x1,
     y0..y1; only text too long even for type.data is cut short -#}
{#- CLOCK: a clock time. 24-hour: 14:05. 12-hour: the half of the day attached as a unit (2:05¦pm); label=true (the time is
     drawn in type.label): where that cut is allowed in capitals only (type.unit is larger than type.label) it is written
     in capitals at the label's size (2:05PM). CLOCK_SPAN: from-to; a span within one half of the day carries it once. -#}
{%- macro CLOCK(ts, h12, label=false) -%}{{ (ts | timestamp_custom('%H:%M')) if not h12 else ((ts | timestamp_custom('%-I:%M%p')) if (label and EP_TK.type.unit[1] > EP_TK.type.label[1]) else ((ts | timestamp_custom('%-I:%M')) ~ '¦' ~ (ts | timestamp_custom('%p') | lower))) }}{%- endmacro -%}
{%- macro CLOCK_SPAN(a, b, h12) -%}{{ ((a | timestamp_custom('%H:%M')) ~ '–' ~ (b | timestamp_custom('%H:%M'))) if not h12 else (((a | timestamp_custom('%-I:%M')) ~ '–' ~ CLOCK(b, true)) if (a | timestamp_custom('%p')) == (b | timestamp_custom('%p')) else (CLOCK(a, true) ~ '¦–' ~ CLOCK(b, true))) }}{%- endmacro -%}
{#- UPPER_VALUE: capitals for the text of a value, never for its units (the segments after a ¦) -#}
{%- macro UPPER_VALUE(v) -%}{%- set o = namespace(l=[]) -%}{%- for p in (v | string).split('¦') -%}{%- set o.l = o.l + [(p | upper) if loop.index0 % 2 == 0 else p] -%}{%- endfor -%}{{ o.l | join('¦') }}{%- endmacro -%}
{%- macro EMPTY(ns, msg, x0, x1, y0, y1) -%}
{%- set msg = UPPER_VALUE(msg) -%}
{%- set dt = EP_TK.type.data -%}
{%- set pt = EP_PRIMARY[1] -%}
{%- if (VALUE_W(msg, pt[1], FONT[pt[0]]) | int) > x1 + 1 - x0 -%}{%- set pt = dt -%}{%- endif -%}
{{- T(ns, msg, (x0 + x1 + 1) // 2, (y0 + y1) // 2, FONT[pt[0]], pt[1], color.ink, 'mm', x1 + 1 - x0) -}}
{%- endmacro -%}
{#- ===== end of kit ===== -#}

{#- moon badge on a hero weather icon: the phase from the moon entity, at the icon box's top-right corner,
     over a paper disc outlined at line.base so every phase reads as a moon (the MDI glyphs only draw the lit part);
     the badge size is in the macro; inside the corner on weather icons of 56 px and up,
     pushed out past the corner on smaller heroes (1.4") so it clears the glyph -#}
{#- MOON_ENTITY: the moon phase sensor (the input, else the Moon integration's); MOON_ON: 'y' when it reports, so a badge is drawn -#}
{%- macro MOON_ENTITY() -%}{{ (moon_phase_sensor | default('') | trim) or ((integration_entities('moon') | first) | default('')) }}{%- endmacro -%}
{%- macro MOON_ON() -%}{%- set me = MOON_ENTITY() | trim -%}{{ 'y' if (me and states(me) not in ['unknown', 'unavailable', '']) else '' }}{%- endmacro -%}
{#- ICONINK: a drawn icon's ink above (g.up) and below (g.dn) its centre at size s (centring by ink, Hero group): ICB's top
     and bottom margins, the moon badge's rim counting as the top where it is higher (2/24 into the box, as MOON_BADGE places it
     where the badge sits inside the corner); an icon ICB doesn't know takes the median weather glyph (ICH) -#}
{#- MOON_SIZE: the moon badge's size on an icon of size s (icon.moonBadge): the largest ladder icon no bigger than a quarter of
     the icon, never below icon.min. It sits inside the icon's corner while it is smaller than half the icon -#}
{%- macro MOON_SIZE(s) -%}{%- set fit = EP_ICON.ladder | select('le', s // 4) | list -%}{{ [EP_TK.icon.min, (fit | last) if fit else 16] | max }}{%- endmacro -%}
{%- macro ICONINK(g, icon, s) -%}
{%- set ik = (icon | string)[4:] if (icon | string)[:4] == 'mdi:' else (icon | string) -%}
{%- set h = 0.5 - (ICH[s] if s in ICH else s) / 2 / s -%}
{%- set mt, mb = (ICB[ik][2], ICB[ik][3]) if ik in ICB else (h, h) -%}
{%- set g.up = s * (0.5 - ([mt, 1 / 12] | min if (MOON_ON() and 2 * (MOON_SIZE(s) | int) < s) else mt)) -%}{%- set g.dn = s * (0.5 - mb) -%}
{%- endmacro -%}
{%- macro MOON_BADGE(ns, icx, icy, s, xmax=9999) -%}
{%- set me = MOON_ENTITY() | trim -%}
{%- set ms = states(me) if me else 'unknown' -%}
{%- if ms not in ['unknown', 'unavailable', ''] -%}
{%- set mi = 'mdi:moon-' ~ ('new' if ms == 'new_moon' else ('full' if ms == 'full_moon' else (ms | replace('_', '-')))) -%}
{#- the badge: the largest ladder icon no bigger than a quarter of the weather icon, never below icon.min; its paper disc
     hugs the glyph's ink (MDI glyphs start 2/24 into their box), outlined at line.base, with a paper ring of 2 x line.base -#}
{%- set b = MOON_SIZE(s) | int -%}{%- set inside = 2 * b < s -%}
{%- set r = b // 2 - b // 12 -%}{%- set rw = EP_TK.line.base -%}
{%- set k = (b // 2) if inside else 2 -%}
{%- set bx = [(icx + s // 2 - k) | int, xmax - r] | min -%}
{#- inside the corner the rim's top lines up with the glyph's top (MDI glyphs start 2/24 into their box) -#}
{%- set by = ((icy - s // 2 + s // 12 + r) if inside else (icy - s // 2 + k)) | int -%}
{%- set ns.el = ns.el + [{'type': 'circle', 'x': bx, 'y': by, 'radius': r + 2 * rw, 'fill': color.paper, 'outline': color.paper, 'width': 1},
                         {'type': 'circle', 'x': bx, 'y': by, 'radius': r, 'fill': color.paper, 'outline': color.ink, 'width': rw}] -%}
{{- I(ns, mi, bx, by, b) -}}
{%- endif -%}
{%- endmacro -%}

{#- LINE_SERIES: a data stroke (line charts, sun path) line.series wide, drawn as 1 px lines: the second one pixel up (shallow) or
     right (steep), a third one down or left; PIL's wider lines thin on shallow slopes -#}
{%- macro LINE_SERIES(ns, x0, y0, x1, y1) -%}{%- set st = ((y1 - y0) | abs) > ((x1 - x0) | abs) -%}
{%- for o in [0, 1, -1, 2, -2][:EP_TK.line.series] -%}{{- L(ns, x0 + (o if st else 0), y0 - (0 if st else o), x1 + (o if st else 0), y1 - (0 if st else o), 1) -}}{%- endfor -%}
{%- endmacro -%}

{#- HERO_ADVANCE: a Space Grotesk Bold string's advance width at size hs (HWR: measured advance per character as a share of the size).
     HERO_INK_W: its ink width: the advance less the first character's left and the last one's right side bearing (SGB, SGR) -#}
{%- macro HERO_ADVANCE(t, hs) -%}{%- set w = namespace(v=0) -%}{%- for c in (t | string) -%}{%- set w.v = w.v + (HWR[c] if c in HWR else 0.6) * hs -%}{%- endfor -%}{{ w.v | round | int }}{%- endmacro -%}
{%- macro HERO_INK_W(t, hs) -%}{%- set t = t | string -%}{%- set w = namespace(v=0) -%}{%- for c in t -%}{%- set w.v = w.v + (HWR[c] if c in HWR else 0.6) * hs -%}{%- endfor -%}
{%- set l = (SGB[hs][t[:1]] if hs in SGB and t[:1] in SGB[hs] else 0) -%}{%- set r = (SGR[hs][t[-1:]] if hs in SGR and t[-1:] in SGR[hs] else 0) -%}{{ (w.v - l - r) | round | int }}{%- endmacro -%}
{#- HERO_LEFT: left x of a hero group beside other content (number + gap + icon) centred by ink in the hero column [P, xr] -#}
{%- macro HERO_LEFT(ts, hs, gap, s, P, xr) -%}{{ (P + ((xr - P) - ((HERO_INK_W(ts, hs) | int) + gap + s)) / 2) | round | int }}{%- endmacro -%}
{#- HERO_SHARED (component 'Hero group', beside other content): the group drawn. h is the hero's content: {'text': the number,
     'level': '' or its flag (a flagged number sits in a hero chip), 'icon', 'moon': the icon carries the moon badge, 'widest':
     the page's widest reading}. The number from hx0, the icon a hero gap after it -#}
{%- macro HERO_SHARED(ns, h, hx0, cy, hs, hic) -%}
{%- set ts = h.text -%}{%- set tw, hg = HERO_INK_W(ts, hs) | int, hs // EP_SPACE.heroGapDiv -%}
{%- if h.level -%}{{- HERO_CHIP(ns, hx0, hx0 + tw - 1, cy, hs, LEVEL_FILL(h.level)) -}}{%- endif -%}
{{- T(ns, ts, HERO_INK_X(hx0, ts, hs) | int, cy, fhero, hs, LEVEL_TEXT(h.level), 'lm') -}}
{{- I(ns, h.icon, hx0 + tw + hg + hic // 2, cy, hic) -}}{%- if h.moon -%}{{- MOON_BADGE(ns, hx0 + tw + hg + hic // 2, cy, hic) -}}{%- endif -%}
{%- endmacro -%}
{#- HBAND (module 'Hero band'): the hero band between the title line (its lower edge at ty) and the next line at sy. The
     detail column (right, from dx) is as wide as its content; the hero group (HERO_SHARED) is centred by ink in what is left,
     space.l from it. Hero and detail rows are each centred by ink between the two lines. rows, flag, od, pol, op: the
     detail rows, the alert row and the make-way orders (DROWS) -#}
{%- macro HBAND(ns, h, ty, sy, rows, flag, od, dx, W, P, pol=none, op=[]) -%}
{%- set hs, hic = EP_TK.type.heroShared, EP_TK.icon.heroShared -%}{%- set hg = hs // EP_SPACE.heroGapDiv -%}
{%- set ik = (h.icon | string)[4:] if (h.icon | string)[:4] == 'mdi:' else (h.icon | string) -%}
{#- the group is centred by ink: the icon's blank right margin (ICB) is left out -#}
{%- set hx0 = HERO_LEFT(h.text, hs, hg, hic - (((ICB[ik][1] if ik in ICB else 0) * hic) | round | int), P, dx - EP_TK.space.l) | int -%}
{%- set cy = (ty + sy) // 2 -%}
{{- HERO_SHARED(ns, h, hx0, cy, hs, hic) -}}
{%- set dr = EP_TK.space.detailRow -%}
{#- DROWS takes the first row's centre y -#}
{%- if rows -%}{{- DROWS(ns, rows, flag, od, dx, W - P - 1, cy - ((rows | length) - 1) * dr // 2, dr, EP_TK.type.fieldLabel, EP_TK.type.data, pol, op) -}}{%- endif -%}
{%- endmacro -%}
{#- HERODASH: pattern 'Hero dashboard', the version with a chart or list, in two equal halves (portrait screens). The title
     row; the top half: the hero group (HERO_SHARED, at the layout's type.heroShared) across the full width and, a hero gap under it, the detail
     rows as a centred block as wide as the group for the widest reading and never narrower than the detail column (wl, wv),
     the whole centred by ink between the title line and the divider; the divider at the middle of the content; the bottom
     half is the page's module: the caller draws it between the two y values it is given (its first text's top, the content's
     bottom) -#}
{%- macro HERODASH(ns, title, right, stale, h, rows, flag, od, wl, wv, pol=none, op=[]) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{%- set ym = (P + TH + H - P) // 2 -%}
{%- set hs, hic = EP_TK.type.heroShared, EP_TK.icon.heroShared -%}{%- set hg = hs // EP_SPACE.heroGapDiv -%}
{%- set ik = (h.icon | string)[4:] if (h.icon | string)[:4] == 'mdi:' else (h.icon | string) -%}
{#- the group's ink above and below its centre line: the digits' or the drawn icon's (ICONINK) -#}
{%- set g = namespace(up=0, dn=0) -%}{{- ICONINK(g, h.icon, hic) -}}
{%- set gup, gdn = [HUP[hs], g.up] | max, [HDN[hs], g.dn] | max -%}
{%- set dr = EP_TK.space.detailRow -%}{%- set n = rows | length -%}{%- set ds = EP_TK.type.data[1] -%}
{#- the rows by ink: the first row's caps to the last row's baseline (a hero gap under the group) -#}
{%- set tot = gup + gdn + hg + (n - 1) * dr + CAPUP[ds] + CAPDN[ds] + 1 -%}
{%- set cy = (P + TH + (ym - (P + TH) - tot) / 2 + gup) | round | int -%}
{#- the group centred by ink across the width -#}
{%- set hx0 = HERO_LEFT(h.text, hs, hg, hic - (((ICB[ik][1] if ik in ICB else 0) * hic) | round | int), P, W - P) | int -%}
{{- HERO_SHARED(ns, h, hx0, cy, hs, hic) -}}
{%- set bw = [DCOLW(wl, wv) | int, (HERO_INK_W(h.widest, hs) | int) + hg + hic] | max -%}
{%- set bx = ((W - bw) / 2) | round | int -%}
{%- set r0 = (cy + gdn + hg + CAPUP[ds]) | round | int -%}
{{- DROWS(ns, rows, flag, od, bx, bx + bw - 1, r0, dr, EP_TK.type.fieldLabel, EP_TK.type.data, pol, op) -}}
{{- L(ns, P, ym, W - P - 1, ym) -}}
{{- caller(ym + EP_TK.line.base + (SPACE_S(EP_TK.type.label[1]) | int), H - P) -}}
{%- endmacro -%}

{#- HERO_BLOCK_Y: Glance vertical layout. The hero group and its Glance secondary are ONE block, centred between the title line and the
     bottom padding. Gap: hero size / 7 from the hero's ink to the secondary's chip box (the box is reserved even without a chip,
     so nothing moves when a chip appears). Returns "hero_cy,second_cy". Mirrors HERO_ALONE's icon fit. -#}
{%- macro HERO_BLOCK_Y(t, hs, ics, W, P, TH, H) -%}
{%- set tin = HERO_INK_W(t, hs) | int -%}
{%- set gap = hs // EP_SPACE.heroGapDiv -%}
{%- set fit = namespace(ic=0) -%}
{%- for c in ics -%}{%- if fit.ic == 0 and tin + gap + c <= W - 2 * P -%}{%- set fit.ic = c -%}{%- endif -%}{%- endfor -%}
{#- measured: the digits' ink above and below the anchor (HUP, HDN), the icon's typical glyph height (ICH) -#}
{%- set ih = (ICH[fit.ic] if fit.ic in ICH else 0) / 2 -%}
{%- set up, dn = [HUP[hs], ih] | max, [HDN[hs], ih] | max -%}
{#- the line under the hero (type.secondary) takes a chip's height: its size + 2 x space.xs -#}
{%- set lb = EP_TK.type.secondary[1] + 2 * (SPACE_XS(EP_TK.type.secondary[1]) | int) -%}
{%- set block = up + dn + gap + lb -%}
{%- set z0, z1 = P + TH, H - P -%}
{%- set top = z0 + (z1 - z0 - block) / 2 -%}
{%- set cy = (top + up) | round | int -%}
{{ cy }},{{ (cy + dn + gap + lb // 2) | round | int }}
{%- endmacro -%}
{#- HBLOCK: the hero block (module 'Hero block'): the hero group on its own and the Glance secondary under it, centred
     as one block between the title line and the bottom padding (HERO_BLOCK_Y). hlevel ('warn' / 'sev') puts the hero in a chip;
     moon adds the moon badge to the icon. The Glance secondary (sec), in type.secondary, centred:
       sec='text'   txt as plain text, cut to the content width when cut
       sec='chip'   txt as a chip at llevel
       sec='caller' the page draws it: {% call(y) ... %}...{% endcall %}, y = the secondary's centre -#}
{%- macro HBLOCK(ns, hero, icon, hlevel='', moon=false, sec='text', txt='', llevel='', cut=true) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{%- set hs, ics = EP_TK.type.heroAlone, EP_TK.icon.heroAloneSteps -%}
{%- set gl = HERO_BLOCK_Y(hero, hs, ics, W, P, TH, H).split(',') | map('int') | list -%}
{{- HERO_ALONE(ns, hero, icon, W, P, gl[0], gl[0], hs, ics, hlevel != '', LEVEL_FILL(hlevel), LEVEL_TEXT(hlevel), moon) -}}
{%- set sf, ss = FONT[EP_TK.type.secondary[0]], EP_TK.type.secondary[1] -%}
{%- if sec == 'caller' -%}{{- caller(gl[1]) -}}
{%- elif sec == 'chip' -%}{{- CCHIP(ns, txt, W // 2, gl[1], sf, ss, 0, LEVEL_FILL(llevel), LEVEL_TEXT(llevel)) -}}
{%- elif txt -%}{{- T(ns, txt, W // 2, gl[1], sf, ss, color.ink, 'mm', (W - 2 * P) if cut else 0) -}}
{%- endif -%}
{%- endmacro -%}
{#- GLANCE: the Glance pattern (design system: Patterns > Glance), the one macro every Glance page draws with: the title
     row (module 'Title row'; stamp `right`, '' for none; `stale` makes it a chip) and the hero block (module 'Hero block').
     The other arguments go to HBLOCK; with sec='caller' the page's call block draws the Glance secondary. -#}
{%- macro GLANCE(ns, title, right, hero, icon, stale=false, hlevel='', moon=false, sec='text', txt='', llevel='', cut=true) -%}
{{- TITLE(ns, title, right, EP_TK.width, EP_TK.space.pad, EP_TK.space.titleRow, stale) -}}
{%- if sec == 'caller' -%}
{%- set outer = caller -%}
{%- call(y) HBLOCK(ns, hero, icon, hlevel, moon, 'caller') -%}{{- outer(y) -}}{%- endcall -%}
{%- else -%}
{{- HBLOCK(ns, hero, icon, hlevel, moon, sec, txt, llevel, cut) -}}
{%- endif -%}
{%- endmacro -%}
{#- ===== Pattern macros: a pattern is one macro that puts its modules on the screen; the page passes its content.
     W, H, P and the title row height come from the tier's tokens. ===== -#}
{#- KVPAGE: pattern 'Key-value list'. items = [[label, value, level]]. err: the message when more than half of the
     values are unavailable (bad of them; lists of 2 or more). dense: space.rowDense rows. One column while every row
     fits, else two columns of equal length. foot: the footer's conclusion, drawn when it fits. -#}
{%- macro KVPAGE(ns, title, right, items, stale=false, bad=0, err='', dense=false, foot='', flevel=none) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{%- set n = items | length -%}
{%- if err and n >= 2 and bad * 2 > n -%}
{{- ERRBLOCK(ns, err, W, H, P, TH) -}}
{%- else -%}
{%- set top = P + TH + (EP_TK.space.m) -%}
{%- set fit = KVFIT(top, H - P, dense) | int -%}
{%- set two = n > fit -%}
{%- set per = ((n + 1) // 2) if two else n -%}
{{- KVLIST(ns, items, P, W - P - 1, top, per, two, dense) -}}
{%- set rh = EP_TK.space.rowDense if dense else EP_TK.space.row -%}
{%- if foot and top + per * rh + (FNEED(P) | int) <= H - P -%}
{{- FOOT(ns, foot, '', W, H, P, flevel) -}}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}
{#- GROUPED: pattern 'Grouped list'. days = [{'head': day header text, 'lines': event lines, 'real': events among them}].
     Fill before you float: whole days while they fit; a day that doesn't fit whole shows the events that do and a "+N"
     text line (more = its text with {e}); later days are left out. -#}
{#- DAYS: the date-grouped list's fill between top and bottom (module 'Date-grouped list'): whole days while they fit,
     then as many events of the next day as fit and its '+N more', then nothing -#}
{%- macro DAYS(ns, days, x0, xr, top, bottom, more, none_txt) -%}
{%- set hh, rh = DAY_HEAD_H() | int, EP_TK.space.rowDense -%}
{%- set avail = bottom - top -%}
{%- set st = namespace(rows=[], used=0, cut=false) -%}
{%- for d in days -%}
{%- if not st.cut -%}
{%- set need = hh + (d.lines | length) * rh -%}
{%- if st.used + need <= avail -%}
{%- set st.rows = st.rows + [{'k': 'head', 't': d.head}] -%}
{%- for l in d.lines -%}{%- set st.rows = st.rows + [{'k': 'ev', 'l': l}] -%}{%- endfor -%}
{%- set st.used = st.used + need -%}
{%- else -%}
{%- set room = ((avail - st.used - hh - rh) // rh) | int -%}
{%- if room > 0 -%}
{%- set st.rows = st.rows + [{'k': 'head', 't': d.head}] -%}
{%- for l in d.lines[:room] -%}{%- set st.rows = st.rows + [{'k': 'ev', 'l': l}] -%}{%- endfor -%}
{%- set st.rows = st.rows + [{'k': 'more', 't': more | replace('{e}', ((d.lines | length) - room) | string)}] -%}
{%- endif -%}
{%- set st.cut = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{- DLIST(ns, st.rows, x0, xr, top, as_timestamp(now()), none_txt) -}}
{%- endmacro -%}
{%- macro GROUPED(ns, title, right, days, more, none_txt) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH) -}}
{{- DAYS(ns, days, P, W - P - 1, P + TH + (EP_TK.space.m), H - P, more, none_txt) -}}
{%- endmacro -%}
{#- EVENTS: pattern 'Event list', and its version with one event as a hero. No events: the empty statement. One: the
     event hero and the footer. More: as many as fit, the footer when it still fits; with fewer, the rows spread by one
     step (M → L) when that still fits. untl, ft, today: the page's words. -#}
{%- macro EVENTS(ns, title, right, events, untl, ft, today, none_txt) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{%- set SM, SL = EP_TK.space.m, EP_TK.space.l -%}
{{- TITLE(ns, title, right, W, P, TH) -}}
{%- set n = events | count -%}
{%- set y0 = P + TH + SM -%}
{%- if n == 0 -%}
{{- EMPTY(ns, none_txt, P, W - P - 1, y0, H - P) -}}
{%- elif n == 1 -%}
{{- EHERO(ns, events[0], W, P, y0) -}}
{{- EFREE(ns, events, ft, today, W, H, P) -}}
{%- else -%}
{%- set foot_h = FNEED(P) | int -%}{%- set rih = EINK() | int -%}
{%- set ep = EPITCH() | int -%}
{%- set shown = [n, ((H - P - rih - y0) // ep) + 1] | min -%}
{%- set pitch = ep + (SL - SM) if (y0 + (shown - 1) * (ep + SL - SM) + rih + foot_h <= H - P) else ep -%}
{{- ELIST(ns, events[:shown], P, W - P - 1, y0, pitch, untl) -}}
{%- if y0 + (shown - 1) * pitch + rih + foot_h <= H - P -%}{{- EFREE(ns, events, ft, today, W, H, P) -}}{%- endif -%}
{%- endif -%}
{%- endmacro -%}
{#- METER_ROWS: module 'Meters', inside the box x0 to x1, y0 to y1 (its first and last column and row). bars = [{'label',
     'percent', 'percent_text', 'marker_pct', 'is_severe', 'is_warning', 'rcap'}], labels already shortened by the page, rcap
     the reset caption ('' for none). Fill before you float: up to 3 bars in type.primary, more in type.data; order fill →
     the room to keep → spread (bars L apart when everything still fits, else M). keep: rows to leave free under the bars
     while they still fit (a page's footer); mt.kept says whether they were.
     METERS: pattern 'Meters': the title row, the bars under it, the footer. reserve: the page has a footer to show (its
     room is kept even when foot is empty); foot, flevel: the conclusion. -#}
{%- macro METER_ROWS(ns, mt, x0, x1, y0, y1, bars, keep=0) -%}
{%- set n = bars | length -%}
{%- set top = y0 -%}
{%- set avail = y1 + 1 - y0 -%}
{%- set big = n <= 3 -%}
{%- set tr, tb = (EP_PRIMARY[0], EP_PRIMARY[1]) if big else (EP_TK.type.data, EP_TK.type.data) -%}
{%- set ts = tb[1] -%}
{%- set cap = CAPH(ts) | int -%}
{#- a bar: the label text line, space.s, the track (the caps' height less space.xs), then space.xs -#}
{%- set th = cap - (SPACE_XS(ts) | int) -%}
{%- set gap = SPACE_S(ts) | int -%}
{%- set bh = cap + gap + th + (SPACE_XS(ts) | int) -%}
{#- the room kept free under the bars (a page's footer) only while the bars still fit M apart; then the bars spread to L -#}
{%- set foot_h = keep if (keep and (n * bh + (n - 1) * (EP_TK.space.m)) + keep <= avail) else 0 -%}
{%- set mt.kept = foot_h > 0 -%}
{%- set g = EP_TK.space.l if (n * bh + (n - 1) * EP_TK.space.l + foot_h) <= avail else EP_TK.space.m -%}
{#- the percentage column starts space.l after the widest label, leaving room for the widest percentage and reset caption -#}
{%- set sl = EP_TK.space.l -%}
{%- set lw = namespace(l=0, r=0) -%}
{%- for b in bars -%}{%- set lw.l = [lw.l, VALUE_W(b.label, ts, FONT[tr[0]]) | int] | max -%}{%- endfor -%}
{%- for b in bars -%}{%- set lw.r = [lw.r, VALUE_W(b.rcap, EP_TK.type.label[1], FONT[EP_TK.type.label[0]]) | int] | max -%}{%- endfor -%}
{%- set pw = VALUE_W(color.severeMark ~ '100%', ts, FONT[tb[0]]) | int -%}
{%- set px = x0 + [lw.l, x1 + 1 - x0 - pw - lw.r - 2 * sl] | min + sl -%}
{%- for b in bars -%}
{%- set y = top + loop.index0 * (bh + g) -%}
{%- set cy = TOPY(y, ts) | int -%}
{{- T(ns, b.label, x0, cy, FONT[tr[0]], ts, color.ink, 'lm', px - x0 - sl) -}}
{%- set ptxt = b.percent_text | replace('--', '—') -%}
{%- set kind = 'sev' if b.is_severe else ('warn' if b.is_warning else '') -%}
{%- set pf = FONT[tb[0]] -%}
{%- if kind -%}{{- RCHIP(ns, (color.severeMark if kind == 'sev' else '') ~ ptxt, px + (VALUE_W((color.severeMark if kind == 'sev' else '') ~ ptxt, ts, pf) | int) - 2, cy, pf, ts, 0, 0, color.severe if kind == 'sev' else color.warningChip, color.onSevere if kind == 'sev' else color.onWarning) -}}
{%- else -%}{{- T(ns, ptxt, px, cy, pf, ts, color.ink, 'lm') -}}{%- endif -%}
{#- the reset caption sits on the bar label's baseline, as the stamp sits on the title's -#}
{%- if b.rcap -%}{{- T(ns, b.rcap, x1, cy + CAPDN[ts] - CAPDN[EP_TK.type.label[1]], FONT[EP_TK.type.label[0]], EP_TK.type.label[1], color.ink, 'rm') -}}{%- endif -%}
{%- set fc = color.severe if kind == 'sev' else (color.warning if kind == 'warn' else color.ink) -%}
{{- PBAR(ns, x0, x1, y + cap + gap, th, b.percent, b.marker_pct, fc) -}}
{%- endfor -%}
{%- endmacro -%}
{%- macro METERS(ns, title, right, bars, stale=false, reserve=false, foot='', flevel=none) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{%- set mt = namespace(kept=false) -%}
{{- METER_ROWS(ns, mt, P, W - P - 1, P + TH + EP_TK.space.m, H - P - 1, bars, (FNEED(P) | int) if reserve else 0) -}}
{%- if foot and mt.kept -%}{{- FOOT(ns, foot, '', W, H, P, flevel) -}}{%- endif -%}
{%- endmacro -%}
{#- CHART_BARS: module 'Chart' as bars, inside the box x0 to x1, y0 to y1 (its first and last column and row). n slots; bars = [{'i': slot, 'v': value, 'f': height as a
     share of the plot, 'level': 'sev', 'warn' or ''}], only the bars with a value above zero are drawn; lines = [[value,
     label]] (warning, severe); cap: a logarithmic scale from 0 to cap (0: linear from 0 to hi). minbar: the smallest bar,
     in line.base. ticks = [[slot, text]] and the end's text. empty: the statement in the
     plot when nothing is above zero (the thresholds are left out then). BARCHART: pattern 'Bar chart', the version
     with thresholds: the title row, the chart between it and the footer, and the footer (left out when nothing is
     above zero); foot = [left, right, level]. flag=false (the reading's switch is
     off): no threshold line or value is drawn; the label margin keeps its width, so the plot doesn't move. -#}
{%- macro CHART_BARS(ns, x0, x1, y0, y1, n, bars, lines, ticks, endtxt, empty, cap=0, hi=0, minbar=1, flag=true) -%}
{%- set lw = namespace(w=0) -%}{%- for v, l in lines -%}{%- set lw.w = [lw.w, VALUE_W(l, EP_TK.type.label[1], FONT[EP_TK.type.label[0]]) | int] | max -%}{%- endfor -%}
{%- set cf = namespace() -%}{{- CFRAME(cf, x0, x1, y0, y1, lw.w) -}}
{%- set x0, top, base, ph = cf.x0, cf.top, cf.base, cf.ph -%}
{%- set slot = cf.w // n -%}
{%- set bw = slot - EP_TK.line.barGap -%}
{%- set xe = x0 + n * slot - 1 -%}{%- set cf.xe = xe -%}
{%- set ly = namespace(l=[]) -%}
{%- for v, l in lines -%}
{%- set f = ((((v | float + 1) | log(10)) / ((cap + 1) | log(10))) if cap else ((v | float) / hi)) -%}
{%- set ly.l = ly.l + [[l, (base - ([[f, 0] | max, 1] | min) * ph) | round | int]] -%}
{%- endfor -%}
{%- set wet = (bars | selectattr('v', 'gt', 0) | list | length) > 0 -%}
{#- dashed threshold lines first, bars on top -#}
{%- for l, y in (ly.l if (wet and flag) else []) -%}{{- CTHRESH(ns, cf, l, y) -}}{%- endfor -%}
{%- for b in bars -%}
{%- if b.v > 0 -%}
{%- set bx = x0 + b.i * slot -%}
{%- set bh = [(b.f * ph) | round | int, minbar * EP_TK.line.base] | max -%}
{%- set by = base - bh -%}
{%- set c = color.severe if b.level == 'sev' else (color.warning if b.level == 'warn' else color.ink) -%}
{{- R(ns, bx, by, bx + bw - 1, base - 1, c) -}}
{#- a paper notch where a threshold crosses the bar; on a yellow bar the dashes stay black -#}
{%- for l, y in (ly.l if flag else []) -%}{%- if by < y -%}{{- L(ns, bx, y, bx + bw - 1, y, 1, color.ink if c == 'yellow' else color.paper) -}}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{{- CBASE(ns, cf) -}}
{%- set tk = namespace(l=[]) -%}
{%- for i, t in ticks -%}{%- set tk.l = tk.l + [[x0 + i * slot, t, 'lm' if i == 0 else 'mm']] -%}{%- endfor -%}
{{- CAXIS(ns, cf, tk.l + [[xe, endtxt, 'rm']]) -}}
{%- if not wet -%}{{- EMPTY(ns, empty, x0, xe - 1, top, base) -}}{%- endif -%}
{%- endmacro -%}
{%- macro BARCHART(ns, title, right, n, bars, lines, ticks, endtxt, foot, empty, stale=false, cap=0, hi=0, minbar=1, flag=true) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{{- CHART_BARS(ns, P, W - P - 1, CHART_Y0() | int, CHART_Y1() | int, n, bars, lines, ticks, endtxt, empty, cap, hi, minbar, flag) -}}
{%- if (bars | selectattr('v', 'gt', 0) | list | length) > 0 -%}{{- FOOT(ns, foot[0], foot[1], W, H, P, foot[2]) -}}{%- endif -%}
{%- endmacro -%}
{#- CHART_LINE: module 'Chart' as a line, inside the box x0 to x1, y0 to y1. pts = [{'ts', 'v': value, 'mx': the sample's maximum}],
     t0 to t1 the time axis (h12: 12-hour labels, CLOCK), lo to hi the fixed y-scale, warn and sev the thresholds, gap: a longer step breaks the line.
     Severity fills under the line, paper notches, the series, the current value as a square, the clock-time axis;
     LINECHART: pattern 'Line chart', the version with thresholds: the title row, the chart, the footer; foot = [left,
     right, level]: the page's conclusion. flag=false (the reading's switch is off): no threshold line or
     value and no fill; the scale, its top value and the label margin stay. -#}
{%- macro CHART_LINE(ns, x0, x1, y0, y1, pts, t0, t1, lo, hi, warn, sev, gap, h12, flag=true) -%}
{#- label margin sized to the widest label + S; labels right-aligned to the padding -#}
{%- set labs = [hi, sev, warn] | map('round') | map('int') | map('string') | list -%}
{%- set lw = namespace(w=0) -%}{%- for l in labs -%}{%- set lw.w = [lw.w, TEXT_W(l, EP_TK.type.label[1], FONT[EP_TK.type.label[0]]) | int] | max -%}{%- endfor -%}
{%- set cf = namespace() -%}{{- CFRAME(cf, x0, x1, y0, y1, lw.w, true) -}}
{%- set x0, pw, top, base, ph = cf.x0, cf.w, cf.top, cf.base, cf.ph -%}
{%- set xe = x0 + pw - 1 -%}{%- set cf.xe = xe -%}
{%- macro ys(v) -%}{{ (base - ([[((v | float) - lo) / (hi - lo), 0] | max, 1] | min) * ph) | round | int }}{%- endmacro -%}
{%- macro xs(t) -%}{{ (x0 + ([[((t | float) - t0) / (t1 - t0), 0] | max, 1] | min) * (pw - 1)) | round | int }}{%- endmacro -%}
{%- set lines = [[warn, ys(warn) | int], [sev, ys(sev) | int], [hi, top]] -%}
{#- severity fills under the line: severe = severe colour, warning = warn colour on BWRY and grayscale panels (mid gray; elsewhere warning is a reference line) -#}
{%- set segs = namespace(list=[]) -%}
{%- for p in pts[1:] -%}
{%- set q = pts[loop.index0] -%}
{%- if (p.ts - q.ts) <= gap -%}
{%- set m = [p.mx, q.mx] | max -%}
{%- set c = (color.severe if m >= sev else (color.warning if (m >= warn and color.warning != color.ink) else '')) if flag else '' -%}
{%- set segs.list = segs.list + [{'xa': xs(q.ts) | int, 'ya': ys(q.v) | int, 'xb': xs(p.ts) | int, 'yb': ys(p.v) | int, 'c': c}] -%}
{%- endif -%}
{%- endfor -%}
{#- neighbouring flat-topped fills of one colour are drawn as one block (identical pixels, fewer elements) -#}
{%- set fm = namespace(list=[]) -%}
{%- for s in segs.list -%}{%- if s.c -%}
{%- set pv = fm.list[-1] if fm.list else none -%}
{%- if pv and pv.c == s.c and pv.ya == pv.yb and s.ya == s.yb and pv.yb == s.ya and pv.xb == s.xa -%}
{%- set fm.list = fm.list[:-1] + [dict(pv, xb=s.xb)] -%}
{%- else -%}{%- set fm.list = fm.list + [s] -%}{%- endif -%}
{%- endif -%}{%- endfor -%}
{%- for s in fm.list -%}
{{- POLY(ns, [[s.xa, base], [s.xa, s.ya], [s.xb, s.yb], [s.xb, base]], s.c) -}}
{%- endfor -%}
{#- thresholds: 1 px dashed (4 on / 4 off) across the plot, value labels in the margin -#}
{%- for v, y in lines -%}{%- if flag or loop.index0 == 2 -%}{{- CTHRESH(ns, cf, v | round | int | string, y, loop.index0 < 2) -}}{%- endif -%}{%- endfor -%}
{#- paper notches where a threshold crosses a severe fill (on a yellow fill the dashes stay black) -#}
{#- touching pieces on one threshold line are drawn as one (identical pixels, fewer elements) -#}
{%- set nt = namespace(l0=[], l1=[]) -%}
{%- for s in segs.list -%}{%- if s.c and s.c != 'yellow' -%}
{%- for v, y in lines[:2] -%}
{%- set ia, ib = s.ya < y, s.yb < y -%}
{%- if ia or ib -%}
{%- set xc = (s.xa + (s.xb - s.xa) * (y - s.ya) / ((s.yb - s.ya) if s.yb != s.ya else 1)) | round | int -%}
{%- set nx0 = s.xa if ia else xc -%}{%- set nx1 = s.xb if ib else xc -%}
{%- if nx1 > nx0 -%}
{%- set cur = nt.l0 if loop.index0 == 0 else nt.l1 -%}
{%- set pv = cur[-1] if cur else none -%}
{%- set cur = (cur[:-1] + [[pv[0], [pv[1], nx1] | max]]) if (pv and nx0 <= pv[1]) else (cur + [[nx0, nx1]]) -%}
{%- if loop.index0 == 0 -%}{%- set nt.l0 = cur -%}{%- else -%}{%- set nt.l1 = cur -%}{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}{%- endfor -%}
{%- for r in nt.l0 -%}{{- L(ns, r[0], lines[0][1], r[1], lines[0][1], 1, color.paper) -}}{%- endfor -%}
{%- for r in nt.l1 -%}{{- L(ns, r[0], lines[1][1], r[1], lines[1][1], 1, color.paper) -}}{%- endfor -%}
{#- the line: 2 px ink, broken where samples are missing -#}
{#- flat neighbouring segments are drawn as one (identical pixels, fewer elements) -#}
{%- set lm = namespace(list=[]) -%}
{%- for s in segs.list -%}
{%- set pv = lm.list[-1] if lm.list else none -%}
{%- if pv and pv.ya == pv.yb and s.ya == s.yb and pv.yb == s.ya and pv.xb == s.xa -%}
{%- set lm.list = lm.list[:-1] + [dict(pv, xb=s.xb)] -%}
{%- else -%}{%- set lm.list = lm.list + [s] -%}{%- endif -%}
{%- endfor -%}
{%- for s in lm.list -%}{{- LINE_SERIES(ns, s.xa, s.ya, s.xb, s.yb) -}}{%- endfor -%}
{{- CBASE(ns, cf) -}}
{#- current value: a filled square (3 x stroke) on the latest point -#}
{%- set last = pts[-1] -%}
{%- set lx, ly = xs(last.ts) | int, ys(last.v) | int -%}
{#- the current value: a square 3 x the series stroke wide, centred on the line's last point -#}
{%- set mq = 3 * EP_TK.line.series -%}
{{- R(ns, lx - mq // 2, ly - mq // 2, lx - mq // 2 + mq - 1, ly - mq // 2 + mq - 1, color.ink) -}}
{#- clock-time axis: EP_CHART.timeTicks labels, evenly spaced from start to end -#}
{%- set tk = namespace(l=[]) -%}
{%- set nt = EP_CHART.timeTicks - 1 -%}
{%- for i in range(nt + 1) -%}
{%- set t = t0 + (t1 - t0) * i / nt -%}
{%- set tk.l = tk.l + [[xs(t) | int, CLOCK(t, h12, true), 'lm' if i == 0 else ('rm' if i == nt else 'mm')]] -%}
{%- endfor -%}
{{- CAXIS(ns, cf, tk.l) -}}
{%- endmacro -%}
{%- macro LINECHART(ns, title, right, pts, t0, t1, lo, hi, warn, sev, gap, foot, h12, stale=false, flag=true) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{{- CHART_LINE(ns, P, W - P - 1, CHART_Y0() | int, CHART_Y1() | int, pts, t0, t1, lo, hi, warn, sev, gap, h12, flag) -}}
{{- FOOT(ns, foot[0], foot[1], W, H, P, foot[2]) -}}
{%- endmacro -%}
{#- TIMELINE_SKY: module 'Timeline', the sun and moon on a compass axis, inside the box xa to xb, ya to yb (its first and
     last column and row). TIMELINE: pattern 'Timeline': the title row, that module between it and the footer, the footer. lat: the home's latitude; north: the northern
     hemisphere (the track centres south); sun_az, sun_el: the sun's position; moon: {'az', 'alt', 'icon'} or none;
     letters: the three compass letters along the track; times = [[label, clock time]] (five) under it; foot: the
     page's conclusion. The vertical rhythm, from the bottom up: the footer, M, the times, space.s, their labels, M, the
     compass row, the horizon; the sky takes what is left. -#}
{%- macro TIMELINE_SKY(ns, xa, xb, ya, yb, lat, north, sun_az, sun_el, moon, letters, times) -%}
{%- set saz, sel = sun_az, sun_el -%}
{#- the track ends half an inline icon inside the padding, so a marker at either end stays inside it -#}
{%- set x0, x1 = xa + EP_TK.icon.inline // 2, xb - EP_TK.icon.inline // 2 -%}
{%- set SEG = 64 -%}
{#- vertical rhythm, from the box's last row up (fill before you float: the sky takes what is left): the
     five times (type.data), space.s, their labels (type.label), M, the compass row (space.axis), the horizon -#}
{%- set M = EP_TK.space.m -%}
{%- set lt, dt = EP_TK.type.label, EP_TK.type.data -%}
{%- set dcy = yb - CAPDN[dt[1]] -%}
{%- set lcy = dcy - CAPUP[dt[1]] - (SPACE_S(dt[1]) | int) - 1 - CAPDN[lt[1]] -%}
{%- set hy = lcy - CAPUP[lt[1]] - M - EP_TK.space.axis - 1 -%}
{%- set cf = namespace(base=hy) -%}{%- set ay = AXIS_Y(cf) | int -%}
{#- vertical scale: the sky runs from M below the title line to the horizon; its top is the highest the sun can get at this
     latitude (90 - |lat| + 23.44 deg), so the summer noon sun reaches the top and the winter sun isn't flattened onto the line -#}
{%- set emax = [90 - (lat | abs) + 23.44, 90] | min -%}
{%- set sky_top = ya -%}
{#- the highest marker, its paper disc and the icon's half stay clear of the sky top -#}
{%- set scale = hy - (sky_top + EP_TK.icon.markerDisc + EP_TK.icon.inline // 2) -%}
{#- azimuth -> x: a time track that runs left to right; north hemisphere centres south, south hemisphere centres north -#}
{%- macro AX(az) -%}{%- set a = (az | float(0)) if north else (((540 - (az | float(0))) % 360)) -%}{{ (x0 + a / 360 * (x1 - x0)) | round | int }}{%- endmacro -%}
{%- macro EY(el) -%}{{ (hy - ([[el | float(0), 0] | max, emax] | min) / emax * scale) | round | int }}{%- endmacro -%}
{#- positions first, so markers below the horizon can push a compass letter aside -#}
{%- set sx = AX(saz) | int -%}
{%- set mpos = namespace(x=-99, up=false) -%}
{%- set mc = 2 * EP_TK.icon.markerDisc -%}
{%- if moon -%}
{%- set mal = moon.alt | float(0) -%}
{%- set mpos.x = AX(moon.az) | int -%}
{%- set mpos.up = mal >= 0 -%}
{%- if not mpos.up and sel < 0 and ((mpos.x - sx) | abs) < mc -%}{%- set mpos.x = mpos.x + mc -%}{%- endif -%}
{#- above the horizon the moon also steps aside when it meets the sun (new moon): two marker discs (2 x icon.markerDisc) to the side it is already on,
     flipped when that would leave the track -#}
{%- if mpos.up and sel >= 0 and ((mpos.x - sx) | abs) < mc and (((EY(mal) | int) - (EY(sel) | int)) | abs) < mc -%}
{%- set dir = 1 if mpos.x >= sx else -1 -%}
{%- if sx + dir * mc < x0 or sx + dir * mc > x1 -%}{%- set dir = 0 - dir -%}{%- endif -%}
{%- set mpos.x = sx + dir * mc -%}
{%- endif -%}
{%- endif -%}
{%- set below = ([sx] if sel < 0 else []) + ([mpos.x] if (mpos.x > -99 and not mpos.up) else []) -%}
{#- horizon + compass ticks; a letter steps aside for a marker under the line -#}
{{- L(ns, xa, hy, xb, hy) -}}
{%- set tk = namespace(l=[]) -%}
{%- for az in [90, 180, 270] -%}
{%- set tx = (x0 + az / 360 * (x1 - x0)) | round | int -%}
{%- set clash = below | select('gt', tx - mc) | select('lt', tx + mc) | list | length > 0 -%}
{%- set tk.l = tk.l + [[tx, '' if clash else letters[loop.index0], 'mm']] -%}
{%- endfor -%}
{{- CAXIS(ns, cf, tk.l) -}}
{#- sunrise and sunset ticks at their real azimuths today: cos(Az) = sin(declination) / cos(latitude) -#}
{%- set doy = now().strftime('%j') | int -%}
{%- set dec = -23.44 * (((360 / 365) * (doy + 10)) * pi / 180) | cos -%}
{%- set q = ((dec * pi / 180) | sin) / ((lat * pi / 180) | cos) -%}
{%- if q | abs < 1 -%}
{%- set raz = (q | acos) * 180 / pi -%}
{%- for a in [raz, 360 - raz] -%}
{%- set rx = AX(a) | int -%}
{{- L(ns, rx, hy - EP_TK.line.tick, rx, hy) -}}
{%- endfor -%}
{%- endif -%}
{#- today's sun path: hour angle -H0..H0, alt/az from declination and latitude; travelled part solid, the rest dotted -#}
{%- set sp, cp = (lat * pi / 180) | sin, (lat * pi / 180) | cos -%}
{%- set sd, cd = (dec * pi / 180) | sin, (dec * pi / 180) | cos -%}
{%- set c0 = -(sp * sd) / (cp * cd) -%}
{%- if c0 < 1 -%}
{%- set h0 = (([c0, -1] | max) | acos) -%}
{%- set pts = namespace(l=[], cut=0) -%}
{%- for i in range(SEG + 1) -%}
{%- set h = -h0 + 2 * h0 * i / SEG -%}
{%- set up = sp * sd + cp * cd * (h | cos) -%}
{%- set no = cp * sd - sp * cd * (h | cos) -%}
{%- set ea = -cd * (h | sin) -%}
{%- set az = ((atan2(ea, no) * 180 / pi) + 360) % 360 -%}
{%- set el = atan2(up, (ea * ea + no * no) | sqrt) * 180 / pi -%}
{%- set pts.l = pts.l + [[AX(az) | float, EY(el) | float]] -%}
{%- if i > 0 and sel >= 0 and pts.l[i][0] <= sx -%}{%- set pts.cut = i -%}{%- endif -%}
{%- endfor -%}
{#- travelled solid, still to come dashed -#}
{{- SERIES(ns, pts.l, pts.cut) -}}
{%- endif -%}
{#- sun marker -#}
{{- TMARK(ns, 'mdi:white-balance-sunny', sx, (EY(sel) | int) if sel >= 0 else ay, sel >= 0) -}}
{#- moon marker: like the sun, above the horizon at its altitude, below it under the line -#}
{%- if moon -%}
{{- TMARK(ns, moon.icon, mpos.x, (EY(mal) | int) if mpos.up else ay, mpos.up) -}}
{%- endif -%}
{#- the five times of the day under the timeline: label above, clock time below -#}
{%- set cw = (xb + 1 - xa) / 5 -%}
{%- for lab, tv in times -%}
{%- set cx = (xa + cw * loop.index0 + cw / 2) | round | int -%}
{{- T(ns, lab, cx, lcy, FONT[lt[0]], lt[1], color.ink, 'mm', cw - (SPACE_S(lt[1]) | int)) -}}
{{- T(ns, tv, cx, dcy, FONT[dt[0]], dt[1], color.ink, 'mm') -}}
{%- endfor -%}
{%- endmacro -%}
{%- macro TIMELINE(ns, title, right, lat, north, sun_az, sun_el, moon, letters, times, foot) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH) -}}
{{- TIMELINE_SKY(ns, P, W - P - 1, CHART_Y0() | int, CHART_Y1() | int, lat, north, sun_az, sun_el, moon, letters, times) -}}
{{- FOOT(ns, foot, '', W, H, P) -}}
{%- endmacro -%}
{#- ---- 5. weather kit (also used by the doors & windows glance) ---- -#}
{%- macro MM(v) -%}{{ '0¦mm' if (v | float(0)) == 0 else (DECIMAL(((v | float) | round(0 if (v | float) >= 10 else 1) | string).replace('.0', '')) ~ '¦mm') }}{%- endmacro -%}
{#- the wind with its unit; a missing value is — alone (*Units and numbers*, *Missing values*) -#}
{%- macro WIND() -%}{{ '—' if wx.wind == '—' else (DECIMAL(wx.wind) ~ '¦' ~ wx.wind_unit) }}{%- endmacro -%}
{#- a value centred at cx: plain / warning chip / severe chip -#}
{%- macro CELL_VALUE(ns, v, cx, cy, f, fb, s, cw, k='', bold=true, p=0) -%}
{%- if k -%}{{- CCHIP(ns, LEVEL_MARK(k) ~ v, cx, cy, fb, s, cw, LEVEL_FILL(k), LEVEL_TEXT(k), p) -}}
{%- else -%}{{- T(ns, v, cx, cy, fb if bold else f, s, color.ink, 'mm') -}}{%- endif -%}
{%- endmacro -%}
{#- Strip cells (component 'Hour cell / Day cell'): every text line is type.data, the regular text lines (hour, high/low, a dry 0 mm)
     in its Regular cut where that cut's stems clear stroke.min (DATA_REGULAR), else Bold. A text line's box is rowMin of type.data
     (cap height + 2 x space.xs + 1); stacked items are space.xs apart, so text lines are space.detailRow apart and a chip on a text line is that pitch - 1 high (a 1 px paper gap to a chip next to it); an icon sits space.xs from the text lines around it. -#}
{%- macro CELL_ROW_H() -%}{%- set ds = EP_TK.type.data[1] -%}{{ (CAPH(ds) | int) + 2 * (SPACE_XS(ds) | int) + 1 }}{%- endmacro -%}
{#- CELLH: a cell's height: three text lines and, with an icon, the icon -#}
{%- macro CELLH(ic) -%}{%- set xs = SPACE_XS(EP_TK.type.data[1]) | int -%}{{ 3 * (CELL_ROW_H() | int) + 2 * xs + ((ic + xs) if ic else 0) }}{%- endmacro -%}
{#- hour cell: time / [icon] / temp / mm; y is the top of the cell -#}
{%- macro HCELL(ns, h, cx, y, ic) -%}
{%- set ds, df, rf = EP_TK.type.data[1], FONT[EP_TK.type.data[0]], DATA_REGULAR() -%}
{%- set xs, r = SPACE_XS(ds) | int, CELL_ROW_H() | int -%}{%- set p = r + xs -%}
{{- CELL_VALUE(ns, h.t, cx, y + xs + CAPUP[ds], rf, df, ds, 0, h.icon_k, false, 0 if ic else p) -}}
{%- set yy = y + r + xs -%}
{%- if ic -%}{{- I(ns, h.icon, cx, yy + ic // 2, ic) -}}{%- set yy = yy + ic + xs -%}{%- endif -%}
{{- CELL_VALUE(ns, (h.temp | string) ~ '°', cx, yy + xs + CAPUP[ds], rf, df, ds, 0, h.temp_k, true, p) -}}
{{- CELL_VALUE(ns, MM(h.mm), cx, yy + p + xs + CAPUP[ds], rf, df, ds, 0, h.mm_k, h.mm > 0, p) -}}
{%- endmacro -%}
{#- day cell: day / icon / hi/lo / mm -#}
{%- macro DCELL(ns, d, cx, y, ic) -%}
{%- set ds, df, rf = EP_TK.type.data[1], FONT[EP_TK.type.data[0]], DATA_REGULAR() -%}
{%- set xs, r = SPACE_XS(ds) | int, CELL_ROW_H() | int -%}{%- set p = r + xs -%}
{{- CELL_VALUE(ns, d.d | upper, cx, y + xs + CAPUP[ds], rf, df, ds, 0, d.icon_k) -}}
{%- set yy = y + r + xs -%}
{{- I(ns, d.icon, cx, yy + ic // 2, ic) -}}
{%- set yy = yy + ic + xs -%}
{{- CELL_VALUE(ns, (d.hi | string) ~ '°/' ~ (d.lo | string) ~ '°', cx, yy + xs + CAPUP[ds], rf, df, ds, 0, d.t_k, false, p) -}}
{{- CELL_VALUE(ns, MM(d.mm), cx, yy + p + xs + CAPUP[ds], rf, df, ds, 0, d.mm_k, d.mm > 0, p) -}}
{%- endmacro -%}
{#- Strips (a line, space.s, a row of cells). STRIPY: the line's y for a strip whose last text line's ink ends just above yb (the
     bottom of the content, the footer's M, or space.s above the next strip's line): the cells' box ends space.xs + 1 lower -#}
{%- macro STRIPY(yb, ic) -%}{{ yb + (SPACE_XS(EP_TK.type.data[1]) | int) + 1 - (CELLH(ic) | int) - (SPACE_S(EP_TK.type.data[1]) | int) - EP_TK.line.base }}{%- endmacro -%}
{#- HSTRIP: n equal cells of hours under the line at y -#}
{%- macro HSTRIP(ns, y, n, ic, W, P) -%}
{{- L(ns, P, y, W - P - 1, y) -}}
{%- set top, cw = y + EP_TK.line.base + (SPACE_S(EP_TK.type.data[1]) | int), (W - 2 * P) / n -%}
{%- set hrs = wx.hours[1:n + 1] if wx.hours | length > n else wx.hours[:n] -%}
{%- for h in hrs -%}{{- HCELL(ns, h, (P + cw * loop.index0 + cw / 2) | round | int, top, ic) -}}{%- endfor -%}
{%- endmacro -%}
{#- DSTRIP: n equal cells of days under the line at y -#}
{%- macro DSTRIP(ns, y, n, ic, W, P) -%}
{{- L(ns, P, y, W - P - 1, y) -}}
{%- set top, cw = y + EP_TK.line.base + (SPACE_S(EP_TK.type.data[1]) | int), (W - 2 * P) / n -%}
{%- for d in wx.days[:n] -%}{{- DCELL(ns, d, (P + cw * loop.index0 + cw / 2) | round | int, top, ic) -}}{%- endfor -%}
{%- endmacro -%}
{#- POLROW: the pollen row (r.pol: type, count and level while pollen is above 0, else none) and the detail column's labels
     and widest values with it (r.wl, r.wv: the configured type and a 3-digit count; a longer one cuts the type) -#}
{%- macro POLROW(r, wl, wv) -%}
{%- set p = wx.pollen -%}
{%- set r.pol = [p.name, p.v, p.k] if (p is not none and p.show) else none -%}
{%- set r.wl = (wl + [p.name]) if p is not none else wl -%}
{%- set r.wv = (wv + ['999' ~ (('¦' ~ (p.v | string).split('¦')[1]) if '¦' in (p.v | string) else '')]) if p is not none else wv -%}
{%- endmacro -%}
{#- the footer's chip: the most severe rain flag among today's total and the forecast hours; none when the whole forecast is dry -#}
{%- macro FOOT_LEVEL() -%}
{%- set ks = [wx.mm_today_k] + (wx.hours | map(attribute='mm_k') | list) -%}
{%- set wet = (wx.hours | selectattr('mm', 'gt', 0) | list | length) > 0 -%}
{{ ('sev' if 'sev' in ks else ('warn' if 'warn' in ks else '')) if wet else '' }}
{%- endmacro -%}
{#- forecast conclusion for a footer: dry until the first wet hour, rain until the first dry hour, or dry for the whole forecast -#}
{%- macro FOOT_FORECAST() -%}
{%- set hs = wx.hours -%}
{%- if not hs -%}{{ '' }}
{%- elif hs[0].mm > 0 -%}
{%- set nx = hs | selectattr('mm', 'le', 0) | list -%}
{{ ((ds_wtxt['rain_until'] | upper) ~ ' ' ~ nx[0].t) if nx else (ds_wtxt['rain'] | upper) }}
{%- else -%}
{%- set nx = hs | selectattr('mm', 'gt', 0) | list -%}
{{ ((ds_wtxt['dry_until'] | upper) ~ ' ' ~ nx[0].t) if nx else (ds_wtxt['dry'] | upper) }}
{%- endif -%}
{%- endmacro -%}
{#- the one flagged item for a single slot, in the system-wide order: an official warning; else the most severe of
     the current condition, pollen (if wp), today's rain, wind - on a tie in that order. Returns 'kind§label§value§short' or '' -#}
{%- macro PICK(wp=true) -%}
{%- set p = wx.pollen -%}
{%- set c = [] -%}
{%- if wx.flag and not wx.alert -%}{%- set c = c + [[wx.flag.k, '', wx.flag.glance, wx.flag.short]] -%}{%- endif -%}
{%- if wp and p is not none and p.k -%}{%- set c = c + [[p.k, p.name | upper, p.v | string, p.v | string]] -%}{%- endif -%}
{%- if wx.mm_today_k -%}{%- set c = c + [[wx.mm_today_k, ds_wtxt['rain'] | upper, MM(wx.mm_today), MM(wx.mm_today)]] -%}{%- endif -%}
{%- if wx.wind_k -%}{%- set c = c + [[wx.wind_k, ds_wtxt['wind'] | upper, WIND(), WIND()]] -%}{%- endif -%}
{%- if wx.hilo_k -%}{%- set c = c + [[wx.hilo_k, ds_wtxt['hilo'] | upper, wx.hi ~ '° / ' ~ wx.lo ~ '°', ((ds_wtxt['hilo'] | upper).split('/')[1] ~ ' ' ~ wx.lo ~ '°') if (flag_temp_low | default(true)) and (wx.lo | float(99)) <= (warning_temp_low | default(-100) | float(-100)) else ((ds_wtxt['hilo'] | upper).split('/')[0] ~ ' ' ~ wx.hi ~ '°')]] -%}{%- endif -%}
{%- set pk = ((c | selectattr(0, 'eq', 'sev') | list) + (c | selectattr(0, 'eq', 'warn') | list)) | first | default(none) -%}
{%- if wx.alert -%}{%- set pk = [wx.flag.k, '', wx.flag.glance, wx.flag.short] -%}{%- endif -%}
{{ (pk | join('§')) if pk else '' }}
{%- endmacro -%}
{#- WXDASH: pattern 'Hero dashboard', the version with forecast strips (landscape screens). Bottom up: the footer (when
     foot), the day strip (days cells, when days), the hour strip (hours cells), then the hero band between the title line
     and the hour strip's line. rows, od: the detail rows and the alert row's make-way order; op: the pollen row's (the
     last detail row while pollen is above 0); wl, wv: the detail column's widest labels and values (the pollen row's
     label is the configured type, its widest value a 3-digit count; a longer one cuts the type). On a portrait screen the detail rows form a centred block
     under a line, M above and below them, as wide as the hero group for the widest reading and never narrower than DCOLW;
     the alert row takes the first row and the pollen row the last, each in place of a row (od, op), as on the landscape screens. The hero group stacks: the number, then the icon under it a hero
     gap (hero / 7) apart by ink, centred by ink between the title line and the details' line. -#}
{#- HERO_STACK: a stacked hero group (component 'Hero group' on a portrait screen): the number centred on cx as a whole
     reading, degree sign included, and its icon a hero gap under it, counted at its nominal ink height (ICH) so the
     number keeps its height when the icon changes. cy: the number's anchor. A flagged number gets the hero chip: hugging
     the number, or from chip_x0 to chip_x1 when the layout gives them. -#}
{%- macro HERO_STACK(ns, txt, level, icon, cx, cy, hs, hic, chip_x0=none, chip_x1=none) -%}
{%- set hg = hs // EP_SPACE.heroGapDiv -%}
{%- set iu = (ICH[hic] if hic in ICH else hic) / 2 -%}
{%- set tw = HERO_INK_W(txt, hs) | int -%}
{%- set x0 = (cx - tw / 2) | round | int -%}
{%- if level -%}{{- HERO_CHIP(ns, x0 if chip_x0 is none else chip_x0, (x0 + tw - 1) if chip_x1 is none else chip_x1, cy, hs, LEVEL_FILL(level)) -}}{%- endif -%}
{{- T(ns, txt, HERO_INK_X(x0, txt, hs) | int, cy, fhero, hs, LEVEL_TEXT(level), 'lm') -}}
{%- set iy = (cy + HDN[hs] + hg + iu) | round | int -%}
{{- I(ns, icon, cx, iy, hic) -}}{{- MOON_BADGE(ns, cx, iy, hic) -}}
{%- endmacro -%}
{%- macro WXDASH(ns, title, right, stale, rows, od, wl, wv, hours, days=0, foot=false, op=[]) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{%- set r = namespace(pol=none, wl=[], wv=[]) -%}{{- POLROW(r, wl, wv) -}}{%- set pol, wl, wv = r.pol, r.wl, r.wv -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{%- set yb = H - P - ((FNEED(P) | int) if foot else 0) -%}
{%- set ih = EP_TK.icon.stripHour or 0 -%}
{%- if days -%}
{%- set dy = STRIPY(yb, EP_TK.icon.stripDay) | int -%}
{%- set sy = STRIPY(dy - (SPACE_S(EP_TK.type.data[1]) | int), ih) | int -%}
{%- else -%}
{%- set sy = STRIPY(yb, ih) | int -%}
{%- endif -%}
{%- if H > W -%}
{%- set dr, m = EP_TK.space.detailRow, EP_TK.space.m -%}
{%- set n = rows | length -%}
{%- set ly = sy - n * dr - 2 * m -%}
{%- set hs, hic = EP_TK.type.heroShared, EP_TK.icon.heroShared -%}{%- set hg = hs // EP_SPACE.heroGapDiv -%}
{#- the group is centred by ink (Hero group); stacked, the icon counts at its nominal ink height (ICH: the same for every
     icon of this size), so the number keeps its height when the icon changes -#}
{%- set iua = (ICH[hic] if hic in ICH else hic) / 2 -%}{%- set ida = iua -%}
{%- set cy = (P + TH + (ly - (P + TH) - (HUP[hs] + HDN[hs] + hg + iua + ida)) / 2 + HUP[hs]) | round | int -%}
{{- HERO_STACK(ns, (wx.temp | string) ~ '°', wx.temp_k, wx.icon, W // 2, cy, hs, hic) -}}
{{- L(ns, P, ly, W - P - 1, ly) -}}
{#- the detail rows: a centred block as wide as the hero group for the widest reading (-12°), never narrower than DCOLW -#}
{%- set bw = [DCOLW(wl, wv) | int, HERO_INK_W('-12°', hs) | int, ICH[hic] if hic in ICH else hic] | max -%}
{%- set bx = ((W - bw) / 2) | round | int -%}
{{- DROWS(ns, rows, wx.flag, od, bx, bx + bw - 1, (ly + sy) // 2 - (n - 1) * dr // 2, dr, EP_TK.type.fieldLabel, EP_TK.type.data, pol, op) -}}
{%- else -%}
{%- set dx = W - P - (DCOLW(wl, wv) | int) -%}
{{- HBAND(ns, {'text': (wx.temp | string) ~ '°', 'level': wx.temp_k, 'icon': wx.icon, 'moon': true, 'widest': '-12°'}, P + TH, sy, rows, wx.flag, od, dx, W, P, pol, op) -}}
{%- endif -%}
{{- HSTRIP(ns, sy, hours, ih, W, P) -}}
{%- if days -%}{{- DSTRIP(ns, dy, days, EP_TK.icon.stripDay, W, P) -}}{%- endif -%}
{%- if foot -%}{{- FOOT(ns, FOOT_FORECAST(), '', W, H, P, FOOT_LEVEL()) -}}{%- endif -%}
{%- endmacro -%}
{#- WXPORT: pattern 'Hero dashboard', the version with forecast strips on a portrait screen: the hero group (number, icon
     under it) with one text line under the icon, over the forecast table (hours, days, the pollen row) and the footer.
     The day rows start tomorrow (today is the hero). wind: the text line shows wind instead of today's rain. -#}
{%- macro WXPORT(ns, title, right, stale, wind) -%}
{%- set nh, nd = 3, 3 -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{{- TITLE(ns, title, right, W, P, TH, stale) -}}
{#- Bottom up, like the other weather layouts with a hero band: the footer, then the table as one block of fixed rows (3 hours, as many
     days as fit up to 3, the pollen row), each section under a line. The hero group (the number, the icon, then the line
     under them, a hero gap (hero / 7) apart by ink) is centred by ink between the title line and the table's line. The
     digits' ink is HUP / HDN around the anchor; the group itself is HERO_STACK -#}
{%- set hs, hic = EP_TK.type.heroShared, EP_TK.icon.heroShared -%}{%- set hg = hs // EP_SPACE.heroGapDiv -%}
{%- set ih = (0.417 * hic) | int -%}
{%- set ds, df = EP_TK.type.data[1], FONT[EP_TK.type.data[0]] -%}
{%- set xs, sx, rh, sl = SPACE_XS(ds) | int, SPACE_S(ds) | int, EP_TK.space.row, EP_TK.space.l -%}
{#- the line under the icon is type.data in a chip-high box (its size + 2 x space.xs) -#}
{%- set lb = ds + 2 * xs -%}
{%- set G = HUP[hs] + HDN[hs] + hg + 2 * ih + hg + lb -%}
{#- the group's ink ends at the text line's caps (a chip's fill hangs space.xs past them, as everywhere) -#}
{%- set Gi = HUP[hs] + HDN[hs] + hg + 2 * ih + hg + lb // 2 + CAPDN[ds] + 1 -%}
{%- set dd = wx.days[1:] -%}
{%- set hrs = wx.hours[1:nh + 1] if wx.hours | length > nh else wx.hours[:nh] -%}
{%- set hp = wx.pollen is not none and wx.pollen.show -%}
{#- the table ends on the footer's line, which closes its last row like the lines between the sections (a row's own
     margin already keeps its ink more than space.m from that line) -#}
{%- set yb = H - P - EP_TK.space.footer -%}
{#- fill before you float: as many day rows (up to nd) as leave the hero group a hero gap above it and space.s below it.
     The pollen row's place is always kept: without pollen one more day row takes it, so the table's top and the hero
     group stay where they are (nothing moves between states) -#}
{%- set fixed = (hrs | length) * rh + rh -%}
{%- set nd = [((yb - fixed - (P + TH) - hg - G - sx) // rh) | int, nd] | min -%}
{%- set yt = yb - fixed - nd * rh -%}
{%- set nd = nd if hp else nd + 1 -%}
{%- set cy = P + TH + (yt - (P + TH) - Gi) // 2 + HUP[hs] -%}
{#- the hero group: the number over its icon; here a flagged number's fill spans the width between the paddings -#}
{{- HERO_STACK(ns, (wx.temp | string) ~ '°', wx.temp_k, wx.icon, W // 2, cy, hs, hic, P, W - P - 1) -}}
{%- set icy = cy + HDN[hs] + hg + ih -%}
{%- set ly = icy + ih + hg + lb // 2 -%}
{#- ranges: hi°/lo° when the widest label, mm and range fit the row with space.l between them, else hi/lo everywhere (*Units and numbers*, *Ranges*) -#}
{%- set wl = namespace(l=0, m=0, r=0) -%}
{%- for d in dd[:nd] -%}{%- set wl.l = [wl.l, VALUE_W(d.d | upper, ds, df) | int] | max -%}{%- set wl.m = [wl.m, VALUE_W(MM(d.mm), ds, df) | int] | max -%}{%- set wl.r = [wl.r, VALUE_W(d.hi ~ '°/' ~ d.lo ~ '°', ds, df) | int] | max -%}{%- endfor -%}
{%- set fit = namespace(ok=(wl.l + sl + wl.m + sl + wl.r <= W - 2 * P)) -%}
{%- macro RANGE(hi, lo) -%}{{ (hi ~ '°/' ~ lo ~ '°') if fit.ok else (hi ~ '/' ~ lo) }}{%- endmacro -%}
{#- high/low · second item. The second item is the flagged item (PICK, the system-wide order) as a chip, else today's rain
     (or wind, with the wind_or_precipitation input). High/low stays unless the chip needs the whole text line -#}
{%- set pk = PICK(false) -%}
{%- set lft = RANGE(wx.hi, wx.lo) ~ ' · ' -%}
{%- set sec = (WIND()) if wind else MM(wx.mm_today) -%}
{%- set cpad = 2 * sx - 2 -%}
{%- if pk and pk.split('§')[2] == wx.hi ~ '° / ' ~ wx.lo ~ '°' -%}
{%- set kind = pk.split('§')[0] -%}
{%- set ctxt = LEVEL_MARK(kind) ~ (ds_wtxt['hilo'] | upper) ~ ' ' ~ RANGE(wx.hi, wx.lo) -%}
{%- set cwid = (VALUE_W(ctxt, ds, df) | int) + cpad -%}
{%- set rt = ' · ' ~ sec -%}
{%- set rw = VALUE_W(rt, ds, df) | int -%}
{%- if cwid + rw > W - 2 * P -%}{%- set rt, rw = '', 0 -%}{%- endif -%}
{%- set x0 = ((W - cwid - rw) / 2) | int -%}
{{- CCHIP(ns, ctxt, x0 + cwid // 2, ly, df, ds, 0, LEVEL_FILL(kind), LEVEL_TEXT(kind)) -}}
{{- T(ns, rt, x0 + cwid, ly, df, ds, color.ink, 'lm') -}}
{%- elif pk -%}
{%- set kind, lab, val, short = pk.split('§') -%}
{%- set full = LEVEL_MARK(kind) ~ ((lab ~ ' ' ~ val) if lab else val) -%}
{%- set lw = VALUE_W(lft, ds, df) | int -%}
{%- set fw = (VALUE_W(full, ds, df) | int) + cpad -%}
{%- if lw + fw <= W - 2 * P -%}{%- set ctxt = full -%}
{%- elif fw <= W - 2 * P -%}{%- set ctxt, lw, lft = full, W, '' -%}
{%- elif (VALUE_W(LEVEL_MARK(kind) ~ short, ds, df) | int) + cpad <= W - 2 * P -%}{%- set ctxt = LEVEL_MARK(kind) ~ short -%}
{%- elif wx.alert -%}{%- set ctxt = LEVEL_MARK(kind) ~ wx.flag.code -%}
{%- else -%}{%- set ctxt = FITW(LEVEL_MARK(kind) ~ short, W - 2 * P - cpad, ds, df) -%}{%- endif -%}
{%- set cwid = (VALUE_W(ctxt, ds, df) | int) + cpad -%}
{%- if lw + cwid <= W - 2 * P -%}
{%- set x0 = ((W - lw - cwid) / 2) | int -%}
{{- T(ns, lft, x0, ly, df, ds, color.ink, 'lm') -}}
{{- CCHIP(ns, ctxt, x0 + lw + cwid // 2, ly, df, ds, 0, LEVEL_FILL(kind), LEVEL_TEXT(kind)) -}}
{%- else -%}{{- CCHIP(ns, ctxt, W // 2, ly, df, ds, 0, LEVEL_FILL(kind), LEVEL_TEXT(kind)) -}}{%- endif -%}
{%- else -%}{{- T(ns, lft ~ sec, W // 2, ly, df, ds, color.ink, 'mm', W - 2 * P) -}}{%- endif -%}
{%- set y = yt -%}
{#- the forecast table: label left, mm right-aligned space.l before the temperature column (as wide as its widest value),
     temperature right; a flagged value is a row chip (row - 1 high) -#}
{%- set tc = namespace(w=0) -%}
{%- for h in hrs -%}{%- set tc.w = [tc.w, VALUE_W(h.temp ~ '°', ds, df) | int] | max -%}{%- endfor -%}
{%- for d in dd[:nd] -%}{%- set tc.w = [tc.w, VALUE_W(RANGE(d.hi, d.lo), ds, df) | int] | max -%}{%- endfor -%}
{%- set mx = W - P - 1 - tc.w - sl -%}
{%- macro RROW(ns, y, a, mm, sev, b, bk='', ak='') -%}
{#- hour labels are short ('15¦h'): the h is styled as a unit and never uppercased -#}
{%- set la = a if '¦' in a else a | upper -%}
{%- set cy = y + rh // 2 -%}
{%- if ak -%}{{- R(ns, P - sx, cy - (rh - 1) // 2, P + (VALUE_W(LEVEL_MARK(ak) ~ la, ds, df) | int) - 2 + sx - 1, cy - (rh - 1) // 2 + rh - 2, LEVEL_FILL(ak)) -}}{%- endif -%}
{{- T(ns, LEVEL_MARK(ak) ~ la, P, cy, df, ds, LEVEL_TEXT(ak), 'lm') -}}
{%- if sev -%}{{- RCHIP(ns, LEVEL_MARK(sev) ~ MM(mm), mx, cy, df, ds, 0, 0, LEVEL_FILL(sev), LEVEL_TEXT(sev), rh) -}}
{%- else -%}{{- T(ns, MM(mm), mx, cy, df, ds, color.ink, 'rm') -}}{%- endif -%}
{%- if bk -%}{{- RCHIP(ns, LEVEL_MARK(bk) ~ b, W - P - 1, cy, df, ds, 0, 0, LEVEL_FILL(bk), LEVEL_TEXT(bk), rh) -}}
{%- else -%}{{- T(ns, b, W - P - 1, cy, df, ds, color.ink, 'rm') -}}{%- endif -%}
{%- endmacro -%}
{{- L(ns, P, y, W - P - 1, y) -}}
{%- for h in hrs -%}{{- RROW(ns, y + loop.index0 * rh, h.ts, h.mm, h.mm_k, h.temp ~ '°', h.temp_k, h.icon_k) -}}{%- endfor -%}
{%- set y = y + (hrs | length) * rh -%}
{{- L(ns, P, y, W - P - 1, y) -}}
{%- for d in dd[:nd] -%}{{- RROW(ns, y + loop.index0 * rh, d.d, d.mm, d.mm_k, RANGE(d.hi, d.lo), d.t_k, d.icon_k) -}}{%- endfor -%}
{%- if hp -%}
{#- the pollen row: type left, count right, under its line like the other sections; at warning or severe level the whole
     row is a row chip (row - 1 high), which replaces the line -#}
{%- set p = wx.pollen -%}
{%- set y = y + nd * rh -%}{%- set pcy = y + rh // 2 -%}
{%- if p.k -%}{{- R(ns, P - sx, pcy - (rh - 1) // 2, W - P - 1 + sx, pcy - (rh - 1) // 2 + rh - 2, LEVEL_FILL(p.k)) -}}
{%- else -%}{{- L(ns, P, y, W - P - 1, y) -}}{%- endif -%}
{{- T(ns, LEVEL_MARK(p.k) ~ (p.name | upper), P, pcy, df, ds, LEVEL_TEXT(p.k), 'lm', W - 2 * P - (VALUE_W(p.v, ds, df) | int) - sl) -}}
{{- T(ns, p.v, W - P - 1, pcy, df, ds, LEVEL_TEXT(p.k), 'rm') -}}
{%- endif -%}
{{- FOOT(ns, FOOT_FORECAST(), '', W, H, P, FOOT_LEVEL()) -}}
{%- endmacro -%}
{#- ---- 6. layouts ---- -#}
{#- one set (design system: Blueprint mechanics, One set): a blueprint whose set id differs from these templates' draws
     the title row and the error block only: the message and, on new lines under it, the two ids (one line where that
     fits, else one each; a blueprint without an id shows the missing value). Compared as text: Home Assistant may hand a
     value over as a number. The lines are wrapped here and drawn one by
     one, so the ids always start a line; the block of lines is centred in the fill -#}
{%- if layout not in EP_LAYOUTS or (c.ds_set | default('—') | string) != (EP_SET | string) -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{%- set pt = (EP_TXT[EP_L.page] | default({}))[weekday_lang] | default({}) -%}
{{- TITLE(ns, header_title if header_title else (pt.default_title | default(EP_WTXT[weekday_lang].title)), as_timestamp(now()), W, P, TH) -}}
{%- set tt = EP_TK.type.title -%}{%- set sx = SPACE_S(tt[1]) | int -%}{%- set mw = W - 2 * P - 2 * sx -%}
{%- set y0, y1 = P + TH + (P // 2), H - P -%}
{{- R(ns, P - sx, y0, W - P - 1 + sx, y1 - 1, color.severe) -}}
{%- set w = namespace(lines=[], cur='') -%}
{%- for word in (EP_SETTXT[weekday_lang] | upper).split(' ') -%}
{%- set t = (w.cur ~ ' ' ~ word) if w.cur else word -%}
{%- if w.cur and (VALUE_W(t, tt[1], FONT[tt[0]]) | int) > mw -%}{%- set w.lines = w.lines + [w.cur] -%}{%- set w.cur = word -%}{%- else -%}{%- set w.cur = t -%}{%- endif -%}
{%- endfor -%}
{%- set a, b = 'BLUEPRINT ' ~ (c.ds_set | default('—') | upper), 'TEMPLATES ' ~ (EP_SET | upper) -%}
{%- set lines = w.lines + [w.cur] + ([a ~ ' · ' ~ b] if (VALUE_W(a ~ ' · ' ~ b, tt[1], FONT[tt[0]]) | int) <= mw else [a, b]) -%}
{%- set pitch = tt[1] + sx -%}
{%- set yc = (y0 + y1) // 2 - ((lines | length) - 1) * pitch // 2 -%}
{%- for s in lines -%}
{%- set ns.el = ns.el + [{'type': 'text', 'value': s, 'x': W // 2, 'y': yc + loop.index0 * pitch, 'font': FONT[tt[0]], 'size': tt[1], 'color': color.onSevere, 'anchor': 'mm'}] -%}
{%- endfor -%}
{%- elif layout == 'appointment_35' and view == 'main' -%}
{%- set events_data = c.events_data -%}
{%- set header_title_display = c.header_title_display -%}
{%- set language_map = c.language_map -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{#- pattern 'Event list' (one event: the event hero); with fewer events the rows spread by one step -#}
{{- EVENTS(ns, header_title_display, as_timestamp(now()), events_data, language_map[weekday_lang]['until'], [language_map[weekday_lang]['free_until'], language_map[weekday_lang]['free_from']], language_map[weekday_lang]['today'], language_map[weekday_lang]['no_events']) -}}
{%- elif layout == 'appointment_35' and view == 'error' -%}
{%- set events_data = c.events_data -%}
{%- set header_title_display = c.header_title_display -%}
{%- set language_map = c.language_map -%}
{{- ERRPAGE(ns, header_title_display, language_map[weekday_lang]['no_calendars']) -}}
{%- elif layout == 'appointment_41' and view == 'main' -%}
{%- set events_data = c.events_data -%}
{%- set header_title_display = c.header_title_display -%}
{%- set language_map = c.language_map -%}
{%- set W, H, P, TH = EP_TK.width, EP_TK.height, EP_TK.space.pad, EP_TK.space.titleRow -%}
{#- pattern 'Event list' (one event: the event hero); with fewer events the rows spread by one step -#}
{{- EVENTS(ns, header_title_display, as_timestamp(now()), events_data, language_map[weekday_lang]['until'], [language_map[weekday_lang]['free_until'], language_map[weekday_lang]['free_from']], language_map[weekday_lang]['today'], language_map[weekday_lang]['no_events']) -}}
